<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="QuickDock.App.Controls.QuickDockStatusPill"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border Background="{ThemeResource PillBackgroundBrush}"
            BorderBrush="{ThemeResource TileStrokeBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource PillCornerRadius}"
            Padding="8,3"
            VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <!-- Status Dot -->
            <Ellipse Width="6" Height="6"
                     Fill="{x:Bind DotBrush, Mode=OneWay}"
                     VerticalAlignment="Center" />
            <!-- Status Text -->
            <TextBlock Text="{x:Bind Text, Mode=OneWay}"
                       FontSize="11"
                       FontWeight="Medium"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       VerticalAlignment="Center" />
        </StackPanel>
    </Border>
</UserControl>

