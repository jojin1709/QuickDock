<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="QuickDock.App.Controls.QuickDockModuleTile"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Button x:Name="RootButton"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            VerticalAlignment="Stretch"
            Padding="12,10"
            CornerRadius="{StaticResource CardCornerRadius}"
            Background="{ThemeResource CardBackgroundBrush}"
            BorderBrush="{ThemeResource TileStrokeBrush}"
            BorderThickness="1"
            Click="OnTileClicked">

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Icon Container -->
            <Border Grid.Column="0"
                    Width="32" Height="32"
                    CornerRadius="6"
                    Background="{ThemeResource PillBackgroundBrush}"
                    VerticalAlignment="Center">
                <FontIcon Glyph="{x:Bind Glyph, Mode=OneWay}"
                          FontSize="16"
                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
            </Border>

            <!-- Text Content -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="{x:Bind Title, Mode=OneWay}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{x:Bind Subtitle, Mode=OneWay}"
                           FontSize="11"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <!-- Status Pill / Badge -->
            <Border Grid.Column="2"
                    VerticalAlignment="Center"
                    Padding="6,2"
                    CornerRadius="10"
                    Background="{ThemeResource PillBackgroundBrush}"
                    Visibility="{x:Bind GetStatusVisibility(StatusText), Mode=OneWay}">
                <TextBlock Text="{x:Bind StatusText, Mode=OneWay}"
                           FontSize="10"
                           FontWeight="Medium"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            </Border>
        </Grid>
    </Button>
</UserControl>

