<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="QuickDock.App.Views.QuickDropView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:QuickDock.Core.Models"
    xmlns:vm="using:QuickDock.App.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid RowSpacing="10">
        <Grid.RowDefinitions>
            <!-- Header bar with Back button -->
            <RowDefinition Height="Auto" />
            <!-- Main Content -->
            <RowDefinition Height="*" />
            <!-- Status footer -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="4,0,4,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Command="{x:Bind MainViewModel.OpenHomeCommand, Mode=OneWay}"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Padding="8"
                    CornerRadius="6"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE72B;" FontSize="14" />
                    <TextBlock Text="Back" FontSize="13" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <TextBlock Grid.Column="1"
                       Text="QuickDrop"
                       FontSize="16"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Margin="12,0,0,0" />

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                <Button Content="Start QuickDrop"
                        Command="{x:Bind ViewModel.StartSessionCommand, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.IsNotRunning, Mode=OneWay}"
                        Style="{StaticResource AccentButtonStyle}"
                        FontSize="12" Padding="10,5" CornerRadius="4" />
                <Button Content="Stop QuickDrop"
                        Command="{x:Bind ViewModel.StopSessionCommand, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.IsRunning, Mode=OneWay}"
                        FontSize="12" Padding="10,5" CornerRadius="4" />
            </StackPanel>
        </Grid>

        <!-- Body -->
        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <!-- Left: QR Code & Connection details -->
                <ColumnDefinition Width="260" />
                <!-- Right: Shared Files & Transfers -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- QR Card -->
            <Border Grid.Column="0"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14">
                <StackPanel Spacing="10" HorizontalAlignment="Center">
                    <TextBlock Text="Local Network Pairing" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Center" />
                    
                    <!-- QR Image -->
                    <Border Width="160" Height="160"
                            Background="White"
                            CornerRadius="8"
                            Padding="6"
                            HorizontalAlignment="Center">
                        <Image Source="{x:Bind ViewModel.QrCodeImage, Mode=OneWay}"
                               Stretch="Uniform"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                    </Border>

                    <TextBlock Text="Scan with your phone camera"
                               FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center" />

                    <!-- Connection Info -->
                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="6"
                            Padding="8,6">
                        <StackPanel Spacing="3">
                            <TextBlock Text="{x:Bind ViewModel.PairingUrl, Mode=OneWay}"
                                       FontSize="10"
                                       FontFamily="Consolas"
                                       TextTrimming="CharacterEllipsis"
                                       HorizontalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
                                <TextBlock Text="Session expires in:" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.RemainingTimeText, Mode=OneWay}"
                                           FontSize="10" FontWeight="SemiBold"
                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Shared Files and Live Transfers -->
            <Grid Grid.Column="1" RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Section Header: Shared Files -->
                <Grid Grid.Row="0">
                    <TextBlock Text="Shared with Connected Device" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                    <Button HorizontalAlignment="Right"
                            Content="+ Share File"
                            Click="OnShareFilePickerClicked"
                            FontSize="11" Padding="8,4" CornerRadius="4" />
                </Grid>

                <!-- Shared Files List -->
                <ListView Grid.Row="1"
                          ItemsSource="{x:Bind ViewModel.SharedFiles, Mode=OneWay}"
                          CornerRadius="8"
                          Background="{ThemeResource LayerFillColorDefaultBrush}"
                          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                          BorderThickness="1"
                          Padding="4">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:QuickDropSharedFile">
                            <Grid Padding="8,6" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <FontIcon Grid.Column="0" Glyph="&#xE8B7;" FontSize="16" VerticalAlignment="Center" />

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{x:Bind FileName}" FontWeight="Medium" FontSize="12" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind FormattedSize}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>

                                <Button Grid.Column="2"
                                        Click="OnRemoveSharedClicked"
                                        Background="Transparent" BorderBrush="Transparent" Padding="4">
                                    <FontIcon Glyph="&#xE711;" FontSize="11" Foreground="#E06C75" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Active Transfers -->
                <ItemsControl Grid.Row="2"
                              ItemsSource="{x:Bind ViewModel.ActiveTransfers, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:TransferItem">
                            <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10,8"
                                    Margin="0,2">
                                <StackPanel Spacing="4">
                                    <Grid>
                                        <TextBlock Text="{x:Bind FileName}" FontWeight="Medium" FontSize="12" />
                                        <TextBlock Text="{x:Bind FormattedProgress}" HorizontalAlignment="Right" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    </Grid>
                                    <ProgressBar Value="{x:Bind ProgressPercentage, Mode=OneTime}" Maximum="100" Height="4" CornerRadius="2" />
                                    <Grid>
                                        <TextBlock Text="{x:Bind FormattedSpeed}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind FormattedTransferred}" HorizontalAlignment="Right" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Grid>

        <!-- Status Footer -->
        <TextBlock Grid.Row="2"
                   Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                   FontSize="11"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Margin="4,0" />
    </Grid>
</UserControl>
