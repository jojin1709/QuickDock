<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="QuickDock.App.Views.DeveloperView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:QuickDock.Core.Models"
    xmlns:vm="using:QuickDock.App.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid RowSpacing="10">
        <Grid.RowDefinitions>
            <!-- Header bar with Back button and Navigation Pills -->
            <RowDefinition Height="Auto" />
            <!-- Section Content -->
            <RowDefinition Height="*" />
            <!-- Status Footer -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="4,0,4,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Back to Home -->
            <Button Grid.Column="0"
                    Command="{x:Bind MainViewModel.OpenHomeCommand, Mode=OneWay}"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Padding="8"
                    CornerRadius="6"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE72B;" FontSize="14" />
                    <TextBlock Text="Back" FontSize="13" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <TextBlock Grid.Column="1"
                       Text="Developer Toolkit"
                       FontSize="16"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Margin="12,0,16,0" />

            <!-- Navigation Bar for Developer Sections -->
            <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button Content="Git" Click="OnNavGitClicked" Padding="10,4" CornerRadius="4" FontSize="12" />
                    <Button Content="Docker" Click="OnNavDockerClicked" Padding="10,4" CornerRadius="4" FontSize="12" />
                    <Button Content="Terminal" Click="OnNavTerminalClicked" Padding="10,4" CornerRadius="4" FontSize="12" />
                    <Button Content="Utilities" Click="OnNavToolsClicked" Padding="10,4" CornerRadius="4" FontSize="12" />
                    <Button Content="HTTP Client" Click="OnNavHttpClicked" Padding="10,4" CornerRadius="4" FontSize="12" />
                    <Button Content="Localhost &amp; Ports" Click="OnNavLocalDevClicked" Padding="10,4" CornerRadius="4" FontSize="12" />
                    <Button Content="Process Monitor" Click="OnNavProcessesClicked" Padding="10,4" CornerRadius="4" FontSize="12" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ==================== MAIN CONTENT AREA ==================== -->
        <Grid Grid.Row="1">

            <!-- 1. GIT SECTION -->
            <Grid Visibility="{x:Bind GetSectionVisibility(ViewModel.SelectedSection, 'Git'), Mode=OneWay}" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Git Toolbar -->
                <Grid Grid.Row="0" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{x:Bind ViewModel.GitRepoPath, Mode=TwoWay}" PlaceholderText="Repository Directory..." CornerRadius="4" />
                    <Button Grid.Column="1" Content="Refresh" Command="{x:Bind ViewModel.RefreshGitCommand, Mode=OneWay}" CornerRadius="4" />
                    <Button Grid.Column="2" Content="Fetch" Command="{x:Bind ViewModel.FetchCommand, Mode=OneWay}" CornerRadius="4" />
                    <Button Grid.Column="3" Content="Pull" Command="{x:Bind ViewModel.PullCommand, Mode=OneWay}" CornerRadius="4" />
                    <Button Grid.Column="4" Content="Push" Command="{x:Bind ViewModel.PushCommand, Mode=OneWay}" CornerRadius="4" />
                </Grid>

                <!-- Git Content Split -->
                <Grid Grid.Row="1" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Files & Commit Area -->
                    <Border Grid.Column="0" Background="{ThemeResource CardBackgroundBrush}" BorderBrush="{ThemeResource TileStrokeBrush}" BorderThickness="1" CornerRadius="6" Padding="10">
                        <Grid RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Branch & Status -->
                            <StackPanel Grid.Row="0" Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE710;" FontSize="13" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="{x:Bind ViewModel.GitBranch, Mode=OneWay}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.GitHeadMessage, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                <Button Content="Stage All (git add -A)" Command="{x:Bind ViewModel.StageAllCommand, Mode=OneWay}" FontSize="11" Padding="6,2" HorizontalAlignment="Stretch" Margin="0,4,0,0" />
                            </StackPanel>

                            <!-- Files List -->
                            <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.GitFiles, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedGitFile, Mode=TwoWay}" SelectionChanged="OnGitFileSelectionChanged">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:GitFileStatus">
                                        <Grid ColumnSpacing="6" Padding="2,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="{ThemeResource PillBackgroundBrush}" CornerRadius="3" Padding="4,1">
                                                <TextBlock Text="{x:Bind StatusBadge}" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{x:Bind Path}" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2">
                                                <Button Content="+" ToolTipService.ToolTip="Stage" Click="OnStageFileClick" Tag="{x:Bind}" FontSize="10" Padding="4,1" />
                                                <Button Content="-" ToolTipService.ToolTip="Unstage" Click="OnUnstageFileClick" Tag="{x:Bind}" FontSize="10" Padding="4,1" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <!-- Commit Box -->
                            <StackPanel Grid.Row="2" Spacing="4">
                                <TextBox Text="{x:Bind ViewModel.GitCommitMessage, Mode=TwoWay}" PlaceholderText="Commit message..." MaxHeight="60" AcceptsReturn="True" FontSize="11" />
                                <Button Content="Commit" Command="{x:Bind ViewModel.CommitCommand, Mode=OneWay}" HorizontalAlignment="Stretch" Background="{ThemeResource AccentFillColorDefaultBrush}" Foreground="White" FontSize="11" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Right: Diff Viewer & Recent Commits -->
                    <Border Grid.Column="1" Background="{ThemeResource CardBackgroundBrush}" BorderBrush="{ThemeResource TileStrokeBrush}" BorderThickness="1" CornerRadius="6" Padding="10">
                        <Grid RowSpacing="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="120" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Diff Viewer" FontWeight="SemiBold" FontSize="12" />
                            <TextBox Grid.Row="1" Text="{x:Bind ViewModel.GitDiffText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas, Cascadia Code, Courier New" FontSize="11" VerticalAlignment="Stretch" />

                            <TextBlock Grid.Row="2" Text="Recent Commits" FontWeight="SemiBold" FontSize="12" Margin="0,4,0,0" />
                            <ListView Grid.Row="3" ItemsSource="{x:Bind ViewModel.GitCommits, Mode=OneWay}">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:GitCommitInfo">
                                        <Grid ColumnSpacing="8" Padding="2,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{x:Bind ShortHash}" FontWeight="Bold" FontFamily="Consolas" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind AuthorName}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Width="90" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="2" Text="{x:Bind Message}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- 2. DOCKER SECTION -->
            <Grid Visibility="{x:Bind GetSectionVisibility(ViewModel.SelectedSection, 'Docker'), Mode=OneWay}" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Docker Status & Actions -->
                <Border Grid.Row="0" Background="{ThemeResource CardBackgroundBrush}" BorderBrush="{ThemeResource TileStrokeBrush}" BorderThickness="1" CornerRadius="6" Padding="12,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE7B8;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind ViewModel.DockerEngineState, Mode=OneWay}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind ViewModel.DockerStatusMessage, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Grid.Column="2" Content="Refresh" Command="{x:Bind ViewModel.RefreshDockerCommand, Mode=OneWay}" CornerRadius="4" />
                    </Grid>
                </Border>

                <!-- Containers and Images List -->
                <Grid Grid.Row="1" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="320" />
                    </Grid.ColumnDefinitions>

                    <!-- Containers -->
                    <Border Grid.Column="0" Background="{ThemeResource CardBackgroundBrush}" BorderBrush="{ThemeResource TileStrokeBrush}" BorderThickness="1" CornerRadius="6" Padding="10">
                        <Grid RowSpacing="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Containers" FontWeight="SemiBold" FontSize="13" />
                            <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.DockerContainers, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedDockerContainer, Mode=TwoWay}">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:DockerContainerInfo">
                                        <Grid ColumnSpacing="8" Padding="2,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="{ThemeResource PillBackgroundBrush}" CornerRadius="3" Padding="4,1">
                                                <TextBlock Text="{x:Bind State}" FontSize="10" FontWeight="Bold" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Names}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind Image}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{x:Bind Ports}" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" Width="90" TextTrimming="CharacterEllipsis" />
                                            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4">
                                                <Button Content="Start" Click="OnStartContainerClick" Tag="{x:Bind}" FontSize="10" Padding="6,2" />
                                                <Button Content="Stop" Click="OnStopContainerClick" Tag="{x:Bind}" FontSize="10" Padding="6,2" />
                                                <Button Content="Logs" Click="OnLogsContainerClick" Tag="{x:Bind}" FontSize="10" Padding="6,2" />
                                                <Button Content="Remove" Click="OnRemoveContainerClick" Tag="{x:Bind}" FontSize="10" Padding="6,2" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <!-- Logs Box -->
                            <TextBox Grid.Row="2" Text="{x:Bind ViewModel.DockerLogsText, Mode=OneWay}" PlaceholderText="Container logs will appear here..." MaxHeight="100" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" FontSize="10" />
                        </Grid>
                    </Border>

                    <!-- Images -->
                    <Border Grid.Column="1" Background="{ThemeResource CardBackgroundBrush}" BorderBrush="{ThemeResource TileStrokeBrush}" BorderThickness="1" CornerRadius="6" Padding="10">
                        <Grid RowSpacing="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Docker Images" FontWeight="SemiBold" FontSize="13" />
                            <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.DockerImages, Mode=OneWay}">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:DockerImageInfo">
                                        <Grid ColumnSpacing="6" Padding="2,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{x:Bind FullName}" FontWeight="SemiBold" FontSize="11" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind ShortId}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{x:Bind Size}" FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0" />
                                            <Button Grid.Column="2" Content="Del" Click="OnRemoveImageClick" Tag="{x:Bind}" FontSize="10" Padding="4,2" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- 3. TERMINAL SECTION -->
            <Border Visibility="{x:Bind GetSectionVisibility(ViewModel.SelectedSection, 'Terminal'), Mode=OneWay}"
                    Background="{ThemeResource CardBackgroundBrush}" BorderBrush="{ThemeResource TileStrokeBrush}" BorderThickness="1" CornerRadius="6" Padding="20">
                <StackPanel Spacing="14" MaxWidth="540" HorizontalAlignment="Left">
                    <TextBlock Text="Terminal Launcher" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="Instantly launch native Windows terminals at your active project or custom folder." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <!-- Terminal Selector -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="Terminal Application" FontWeight="Medium" FontSize="12" />
                        <ComboBox SelectedIndex="0" SelectionChanged="OnTerminalTypeSelectionChanged" HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="Windows Terminal (wt.exe)" />
                            <ComboBoxItem Content="PowerShell (pwsh.exe / powershell.exe)" />
                            <ComboBoxItem Content="Command Prompt (cmd.exe)" />
                        </ComboBox>
                    </StackPanel>

                    <!-- Directory -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="Working Directory" FontWeight="Medium" FontSize="12" />
                        <TextBox Text="{x:Bind ViewModel.TerminalDirectory, Mode=TwoWay}" CornerRadius="4" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Use QuickDock Directory" Command="{x:Bind ViewModel.SetTerminalDirectoryToCurrentCommand, Mode=OneWay}" FontSize="11" Padding="8,4" />
                            <Button Content="Use Git Repo Directory" Command="{x:Bind ViewModel.SetTerminalDirectoryToGitCommand, Mode=OneWay}" FontSize="11" Padding="8,4" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Run As Administrator -->
                    <CheckBox Content="Launch as Administrator (Elevated)" IsChecked="{x:Bind ViewModel.TerminalAsAdmin, Mode=TwoWay}" />

                    <!-- Launch Button -->
                    <Button Content="Launch Terminal" Command="{x:Bind ViewModel.LaunchTerminalCommand, Mode=OneWay}" Background="{ThemeResource AccentFillColorDefaultBrush}" Foreground="White" Padding="16,8" CornerRadius="6" FontWeight="SemiBold" />
                    <TextBlock Text="{x:Bind ViewModel.TerminalStatusMessage, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                </StackPanel>
            </Border>

            <!-- 4. DEVELOPER UTILITIES SECTION -->
            <Grid Visibility="{x:Bind GetSectionVisibility(ViewModel.SelectedSection, 'Tools'), Mode=OneWay}" RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Tool Tabs -->
                <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Button Content="JSON" Click="OnToolJsonClicked" Padding="10,4" CornerRadius="4" FontSize="11" />
                        <Button Content="JWT" Click="OnToolJwtClicked" Padding="10,4" CornerRadius="4" FontSize="11" />
                        <Button Content="Encoding" Click="OnToolEncodingClicked" Padding="10,4" CornerRadius="4" FontSize="11" />
                        <Button Content="Hashing" Click="OnToolHashClicked" Padding="10,4" CornerRadius="4" FontSize="11" />
                        <Button Content="UUID" Click="OnToolUuidClicked" Padding="10,4" CornerRadius="4" FontSize="11" />
                        <Button Content="Timestamp" Click="OnToolTimestampClicked" Padding="10,4" CornerRadius="4" FontSize="11" />
                        <Button Content="Regex" Click="OnToolRegexClicked" Padding="10,4" CornerRadius="4" FontSize="11" />
                        <Button Content="QR Code" Click="OnToolQrClicked" Padding="10,4" CornerRadius="4" FontSize="11" />
                    </StackPanel>
                </ScrollViewer>

                <!-- Tool Body -->
                <Border Grid.Row="1" Background="{ThemeResource CardBackgroundBrush}" BorderBrush="{ThemeResource TileStrokeBrush}" BorderThickness="1" CornerRadius="6" Padding="12">
                    <Grid>
                        <!-- JSON Tool -->
                        <Grid Visibility="{x:Bind GetToolVisibility(ViewModel.SelectedTool, 'Json'), Mode=OneWay}" RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6">
                                <Button Content="Format (Indent)" Command="{x:Bind ViewModel.FormatJsonCommand, Mode=OneWay}" FontSize="11" Padding="8,4" />
                                <Button Content="Minify" Command="{x:Bind ViewModel.MinifyJsonCommand, Mode=OneWay}" FontSize="11" Padding="8,4" />
                                <Button Content="Validate" Command="{x:Bind ViewModel.ValidateJsonCommand, Mode=OneWay}" FontSize="11" Padding="8,4" />
                                <Button Content="Clear" Command="{x:Bind ViewModel.ClearJsonCommand, Mode=OneWay}" FontSize="11" Padding="8,4" />
                                <TextBlock Text="{x:Bind ViewModel.JsonStatusMessage, Mode=OneWay}" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            </StackPanel>
                            <Grid Grid.Row="1" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{x:Bind ViewModel.JsonInput, Mode=TwoWay}" PlaceholderText="Enter JSON here..." AcceptsReturn="True" FontFamily="Consolas" FontSize="11" />
                                <TextBox Grid.Column="1" Text="{x:Bind ViewModel.JsonOutput, Mode=OneWay}" PlaceholderText="Formatted JSON output..." IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" FontSize="11" />
                            </Grid>
                        </Grid>

                        <!-- JWT Tool -->
                        <Grid Visibility="{x:Bind GetToolVisibility(ViewModel.SelectedTool, 'Jwt'), Mode=OneWay}" RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Spacing="4">
                                <TextBlock Text="JWT Token" FontWeight="Medium" FontSize="11" />
                                <TextBox Text="{x:Bind ViewModel.JwtInput, Mode=TwoWay}" PlaceholderText="Paste JWT (header.payload.signature)..." Height="50" AcceptsReturn="True" FontSize="11" />
                            </StackPanel>
                            <Grid Grid.Row="1" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{x:Bind ViewModel.JwtSecret, Mode=TwoWay}" PlaceholderText="HMAC Secret Key (optional for verification)..." FontSize="11" />
                                <Button Grid.Column="1" Content="Decode &amp; Verify" Command="{x:Bind ViewModel.DecodeJwtCommand, Mode=OneWay}" FontSize="11" Padding="10,4" />
                                <Button Grid.Column="2" Content="Clear" Command="{x:Bind ViewModel.ClearJwtCommand, Mode=OneWay}" FontSize="11" Padding="10,4" />
                            </Grid>
                            <Grid Grid.Row="2" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="4">
                                    <TextBlock Text="Header (Decoded)" FontWeight="Medium" FontSize="11" />
                                    <TextBox Text="{x:Bind ViewModel.JwtHeaderJson, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" FontSize="11" Height="140" />
                                    <TextBlock Text="{x:Bind ViewModel.JwtStatusMessage, Mode=OneWay}" FontSize="10" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Text="Payload Claims (Decoded)" FontWeight="Medium" FontSize="11" />
                                    <TextBox Text="{x:Bind ViewModel.JwtPayloadJson, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" FontSize="11" Height="140" />
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <!-- Encoding Tool -->
                        <Grid Visibility="{x:Bind GetToolVisibility(ViewModel.SelectedTool, 'Encoding'), Mode=OneWay}" RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6">
                                <Button Content="Base64 Encode" Command="{x:Bind ViewModel.Base64EncodeCommand, Mode=OneWay}" FontSize="11" Padding="8,4" />
                                <Button Content="Base64 Decode" Command="{x:Bind ViewModel.Base64DecodeCommand, Mode=OneWay}" FontSize="11" Padding="8,4" />
                                <Button Content="URL Encode" Command="{x:Bind ViewModel.UrlEncodeCommand, Mode=OneWay}" FontSize="11" Padding="8,4" />
                                <Button Content="URL Decode" Command="{x:Bind ViewModel.UrlDecodeCommand, Mode=OneWay}" FontSize="11" Padding="8,4" />
                                <TextBlock Text="{x:Bind ViewModel.EncodingStatusMessage, Mode=OneWay}" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            </StackPanel>
                            <TextBox Grid.Row="1" Text="{x:Bind ViewModel.EncodingInput, Mode=TwoWay}" PlaceholderText="Input text here..." AcceptsReturn="True" FontSize="11" />
                            <TextBox Grid.Row="2" Text="{x:Bind ViewModel.EncodingOutput, Mode=OneWay}" PlaceholderText="Encoded / Decoded result..." IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" FontSize="11" />
                        </Grid>

                        <!-- Hashing Tool -->
                        <Grid Visibility="{x:Bind GetToolVisibility(ViewModel.SelectedTool, 'Hash'), Mode=OneWay}" RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                                <ComboBox SelectedIndex="2" SelectionChanged="OnHashAlgorithmSelectionChanged" FontSize="11">
                                    <ComboBoxItem Content="MD5" />
                                    <ComboBoxItem Content="SHA-1" />
                                    <ComboBoxItem Content="SHA-256" />
                                    <ComboBoxItem Content="SHA-384" />
                                    <ComboBoxItem Content="SHA-512" />
                                </ComboBox>
                                <Button Content="Compute Hash" Command="{x:Bind ViewModel.ComputeHashCommand, Mode=OneWay}" FontSize="11" Padding="10,4" />
                                <TextBlock Text="{x:Bind ViewModel.HashStatusMessage, Mode=OneWay}" FontSize="11" VerticalAlignment="Center" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            </StackPanel>
                            <TextBox Grid.Row="1" Text="{x:Bind ViewModel.HashInput, Mode=TwoWay}" PlaceholderText="Enter string to hash..." AcceptsReturn="True" FontSize="11" />
                            <TextBox Grid.Row="2" Text="{x:Bind ViewModel.HashOutput, Mode=OneWay}" PlaceholderText="Hex hash will appear here..." IsReadOnly="True" FontFamily="Consolas" FontSize="12" />
                        </Grid>

                        <!-- UUID Tool -->
                        <Grid Visibility="{x:Bind GetToolVisibility(ViewModel.SelectedTool, 'Uuid'), Mode=OneWay}" RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10">
                                <Button Content="Generate UUID" Command="{x:Bind ViewModel.GenerateUuidCommand, Mode=OneWay}" FontSize="11" Padding="10,4" Background="{ThemeResource AccentFillColorDefaultBrush}" Foreground="White" />
                                <CheckBox Content="Uppercase" IsChecked="{x:Bind ViewModel.UuidUppercase, Mode=TwoWay}" FontSize="11" />
                                <CheckBox Content="Hyphens" IsChecked="{x:Bind ViewModel.UuidHyphens, Mode=TwoWay}" FontSize="11" />
                                <CheckBox Content="Braces {}" IsChecked="{x:Bind ViewModel.UuidBraces, Mode=TwoWay}" FontSize="11" />
                            </StackPanel>
                            <TextBox Grid.Row="1" Text="{x:Bind ViewModel.UuidOutput, Mode=OneWay}" PlaceholderText="Generated UUIDs..." IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" FontSize="12" />
                        </Grid>

                        <!-- Timestamp Tool -->
                        <StackPanel Visibility="{x:Bind GetToolVisibility(ViewModel.SelectedTool, 'Timestamp'), Mode=OneWay}" Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBox Text="{x:Bind ViewModel.TimestampInput, Mode=TwoWay}" PlaceholderText="Unix seconds or milliseconds..." Width="220" FontSize="11" />
                                <Button Content="Convert" Command="{x:Bind ViewModel.ConvertTimestampCommand, Mode=OneWay}" FontSize="11" Padding="10,4" />
                                <Button Content="Current Time (Now)" Command="{x:Bind ViewModel.SetCurrentTimestampCommand, Mode=OneWay}" FontSize="11" Padding="10,4" />
                            </StackPanel>
                            <TextBox Text="{x:Bind ViewModel.TimestampIsoOutput, Mode=OneWay}" PlaceholderText="Formatted date..." IsReadOnly="True" FontFamily="Consolas" FontSize="12" />
                            <TextBlock Text="{x:Bind ViewModel.TimestampRelativeOutput, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.TimestampStatusMessage, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <!-- Regex Tool -->
                        <Grid Visibility="{x:Bind GetToolVisibility(ViewModel.SelectedTool, 'Regex'), Mode=OneWay}" RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{x:Bind ViewModel.RegexPattern, Mode=TwoWay}" PlaceholderText="Regular expression pattern..." FontFamily="Consolas" FontSize="11" />
                                <TextBox Grid.Column="1" Text="{x:Bind ViewModel.RegexReplacement, Mode=TwoWay}" PlaceholderText="Replacement string (optional)..." FontFamily="Consolas" FontSize="11" />
                                <Button Grid.Column="2" Content="Test Pattern" Command="{x:Bind ViewModel.TestRegexCommand, Mode=OneWay}" FontSize="11" Padding="10,4" />
                            </Grid>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10">
                                <CheckBox Content="Ignore Case" IsChecked="{x:Bind ViewModel.RegexIgnoreCase, Mode=TwoWay}" FontSize="11" />
                                <CheckBox Content="Multiline" IsChecked="{x:Bind ViewModel.RegexMultiline, Mode=TwoWay}" FontSize="11" />
                                <CheckBox Content="Singleline" IsChecked="{x:Bind ViewModel.RegexSingleline, Mode=TwoWay}" FontSize="11" />
                                <TextBlock Text="{x:Bind ViewModel.RegexStatusMessage, Mode=OneWay}" FontSize="11" VerticalAlignment="Center" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            </StackPanel>
                            <Grid Grid.Row="2" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{x:Bind ViewModel.RegexInput, Mode=TwoWay}" PlaceholderText="Test string..." AcceptsReturn="True" FontSize="11" />
                                <TextBox Grid.Column="1" Text="{x:Bind ViewModel.RegexOutput, Mode=OneWay}" PlaceholderText="Matches and groups..." IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" FontSize="11" />
                            </Grid>
                        </Grid>

                        <!-- QR Code Tool -->
                        <Grid Visibility="{x:Bind GetToolVisibility(ViewModel.SelectedTool, 'Qr'), Mode=OneWay}" RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{x:Bind ViewModel.QrInput, Mode=TwoWay}" PlaceholderText="Text or URL to encode in QR..." FontSize="11" />
                                <Button Grid.Column="1" Content="Generate QR" Command="{x:Bind ViewModel.GenerateQrCommand, Mode=OneWay}" FontSize="11" Padding="10,4" />
                            </Grid>
                            <Grid Grid.Row="1" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="White" CornerRadius="6" Padding="8" HorizontalAlignment="Center" VerticalAlignment="Top">
                                    <Image x:Name="QrDisplayImage" Width="180" Height="180" Stretch="Uniform" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind ViewModel.QrStatusMessage, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock Text="Instant offline vector QR generation. Reuses QuickDrop QR rendering." FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- 5. HTTP / API TOOLKIT SECTION -->
            <Grid Visibility="{x:Bind GetSectionVisibility(ViewModel.SelectedSection, 'Http'), Mode=OneWay}" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- URL & Send bar -->
                <Grid Grid.Row="0" ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0" SelectedIndex="0" SelectionChanged="OnHttpMethodSelectionChanged" HorizontalAlignment="Stretch" FontSize="11">
                        <ComboBoxItem Content="GET" />
                        <ComboBoxItem Content="POST" />
                        <ComboBoxItem Content="PUT" />
                        <ComboBoxItem Content="PATCH" />
                        <ComboBoxItem Content="DELETE" />
                        <ComboBoxItem Content="HEAD" />
                    </ComboBox>
                    <TextBox Grid.Column="1" Text="{x:Bind ViewModel.HttpUrl, Mode=TwoWay}" PlaceholderText="Enter request URL (https://...)" FontSize="11" />
                    <Button Grid.Column="2" Content="Send" Command="{x:Bind ViewModel.SendHttpRequestCommand, Mode=OneWay}" Background="{ThemeResource AccentFillColorDefaultBrush}" Foreground="White" FontSize="11" Padding="12,4" />
                    <Button Grid.Column="3" Content="Cancel" Command="{x:Bind ViewModel.CancelHttpRequestCommand, Mode=OneWay}" FontSize="11" Padding="8,4" />
                </Grid>

                <!-- Request / Response Split -->
                <Grid Grid.Row="1" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Request Config -->
                    <Border Grid.Column="0" Background="{ThemeResource CardBackgroundBrush}" BorderBrush="{ThemeResource TileStrokeBrush}" BorderThickness="1" CornerRadius="6" Padding="10">
                        <Grid RowSpacing="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Headers (Key: Value per line)" FontWeight="Medium" FontSize="11" />
                            <TextBox Grid.Row="1" Text="{x:Bind ViewModel.HttpHeadersInput, Mode=TwoWay}" AcceptsReturn="True" FontFamily="Consolas" FontSize="10" />
                            <TextBlock Grid.Row="2" Text="Request Body (JSON / text)" FontWeight="Medium" FontSize="11" Margin="0,4,0,0" />
                            <TextBox Grid.Row="3" Text="{x:Bind ViewModel.HttpBodyInput, Mode=TwoWay}" AcceptsReturn="True" FontFamily="Consolas" FontSize="10" />
                        </Grid>
                    </Border>

                    <!-- Response Viewer -->
                    <Border Grid.Column="1" Background="{ThemeResource CardBackgroundBrush}" BorderBrush="{ThemeResource TileStrokeBrush}" BorderThickness="1" CornerRadius="6" Padding="10">
                        <Grid RowSpacing="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{ThemeResource PillBackgroundBrush}" CornerRadius="4" Padding="6,2">
                                    <TextBlock Text="{x:Bind ViewModel.HttpResponseStatus, Mode=OneWay}" FontWeight="Bold" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                </Border>
                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.HttpResponseMetrics, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <TextBox Grid.Row="1" Text="{x:Bind ViewModel.HttpResponseBody, Mode=OneWay}" PlaceholderText="Response body will appear here..." IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" FontSize="11" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- 6. LOCALHOST & PORTS SECTION -->
            <Grid Visibility="{x:Bind GetSectionVisibility(ViewModel.SelectedSection, 'LocalDev'), Mode=OneWay}" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{x:Bind ViewModel.PortSearchFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Filter by port or process name..." FontSize="11" />
                    <Button Grid.Column="1" Content="Refresh Ports" Command="{x:Bind ViewModel.RefreshPortsCommand, Mode=OneWay}" FontSize="11" Padding="10,4" />
                </Grid>

                <Border Grid.Row="1" Background="{ThemeResource CardBackgroundBrush}" BorderBrush="{ThemeResource TileStrokeBrush}" BorderThickness="1" CornerRadius="6" Padding="6">
                    <ListView ItemsSource="{x:Bind ViewModel.FilteredPorts, Mode=OneWay}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:ListeningPortInfo">
                                <Grid ColumnSpacing="8" Padding="4,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="{ThemeResource PillBackgroundBrush}" CornerRadius="3" Padding="4,1" HorizontalAlignment="Left">
                                        <TextBlock Text="{x:Bind Port}" FontWeight="Bold" FontFamily="Consolas" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{x:Bind LocalAddress}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind ProcessName}" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind ProcessId}" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <Button Grid.Column="4" Content="Open URL" Click="OnOpenPortUrlClick" Tag="{x:Bind}" FontSize="10" Padding="6,2" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>
            </Grid>

            <!-- 7. PROCESS MONITOR SECTION -->
            <Grid Visibility="{x:Bind GetSectionVisibility(ViewModel.SelectedSection, 'Processes'), Mode=OneWay}" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{x:Bind ViewModel.ProcessSearchFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Filter by process name, PID, or port..." FontSize="11" />
                    <Button Grid.Column="1" Content="Refresh Processes" Command="{x:Bind ViewModel.RefreshProcessesCommand, Mode=OneWay}" FontSize="11" Padding="10,4" />
                </Grid>

                <Border Grid.Row="1" Background="{ThemeResource CardBackgroundBrush}" BorderBrush="{ThemeResource TileStrokeBrush}" BorderThickness="1" CornerRadius="6" Padding="6">
                    <ListView ItemsSource="{x:Bind ViewModel.FilteredProcesses, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedProcess, Mode=TwoWay}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:DeveloperProcessInfo">
                                <Grid ColumnSpacing="8" Padding="4,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Bind ProcessId}" FontWeight="Bold" FontFamily="Consolas" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind ProcessName}" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind WorkingSetMb}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind PortsSummary}" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <Button Grid.Column="4" Content="Folder" Click="OnOpenProcessFolderClick" Tag="{x:Bind}" FontSize="10" Padding="6,2" />
                                    <Button Grid.Column="5" Content="Terminate" Click="OnTerminateProcessClick" Tag="{x:Bind}" FontSize="10" Padding="6,2" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>
            </Grid>

        </Grid>

        <!-- Status Footer -->
        <Border Grid.Row="2" Padding="4,2">
            <TextBlock Text="{x:Bind ViewModel.GitStatusMessage, Mode=OneWay}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
        </Border>
    </Grid>
</UserControl>
