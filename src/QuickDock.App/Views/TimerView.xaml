<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="QuickDock.App.Views.TimerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:QuickDock.Core.Models"
    xmlns:vm="using:QuickDock.App.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid RowSpacing="10">
        <Grid.RowDefinitions>
            <!-- Header bar with Back button -->
            <RowDefinition Height="Auto" />
            <!-- Tab Switcher -->
            <RowDefinition Height="Auto" />
            <!-- Main Content Area -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="4,0,4,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Command="{x:Bind MainViewModel.OpenHomeCommand, Mode=OneWay}"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Padding="8"
                    CornerRadius="6"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE72B;" FontSize="14" />
                    <TextBlock Text="Back" FontSize="13" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <TextBlock Grid.Column="1"
                       Text="Time &amp; Focus"
                       FontSize="16"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Margin="12,0,0,0" />
        </Grid>

        <!-- Tab Selector Buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <Button Content="Timers"
                    Click="OnTabTimersClicked"
                    Padding="14,6"
                    CornerRadius="6" />
            <Button Content="Stopwatch"
                    Click="OnTabStopwatchClicked"
                    Padding="14,6"
                    CornerRadius="6" />
            <Button Content="Pomodoro"
                    Click="OnTabPomodoroClicked"
                    Padding="14,6"
                    CornerRadius="6" />
        </StackPanel>

        <!-- Content Panels based on SelectedTabIndex -->
        <Grid Grid.Row="2">
            <!-- 0: Timers Panel -->
            <ScrollViewer Visibility="{x:Bind GetTabVisibility(ViewModel.SelectedTabIndex, 0), Mode=OneWay}"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="14">
                    <!-- Preset buttons -->
                    <TextBlock Text="PRESETS"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="5m" HorizontalAlignment="Stretch" Click="OnPreset5Clicked" />
                        <Button Grid.Column="1" Content="15m" HorizontalAlignment="Stretch" Click="OnPreset15Clicked" />
                        <Button Grid.Column="2" Content="25m" HorizontalAlignment="Stretch" Click="OnPreset25Clicked" />
                        <Button Grid.Column="3" Content="45m" HorizontalAlignment="Stretch" Click="OnPreset45Clicked" />
                    </Grid>

                    <!-- Active Timers -->
                    <TextBlock Text="ACTIVE TIMERS"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Margin="0,8,0,0" />

                    <ItemsControl ItemsSource="{x:Bind ViewModel.Timers, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:TimerItem">
                                <Border Margin="0,0,0,8"
                                        Padding="12,10"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Name}" FontWeight="Medium" FontSize="14" />
                                            <TextBlock Text="{x:Bind State}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="1"
                                                   Text="{x:Bind FormattedTime}"
                                                   FontSize="20"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                            <Button Tag="{x:Bind Id}"
                                                    Click="OnStartTimerClicked"
                                                    Background="Transparent"
                                                    BorderBrush="Transparent"
                                                    Padding="6">
                                                <FontIcon Glyph="&#xE768;" FontSize="13" />
                                            </Button>
                                            <Button Tag="{x:Bind Id}"
                                                    Click="OnPauseTimerClicked"
                                                    Background="Transparent"
                                                    BorderBrush="Transparent"
                                                    Padding="6">
                                                <FontIcon Glyph="&#xE769;" FontSize="13" />
                                            </Button>
                                            <Button Tag="{x:Bind Id}"
                                                    Click="OnResetTimerClicked"
                                                    Background="Transparent"
                                                    BorderBrush="Transparent"
                                                    Padding="6">
                                                <FontIcon Glyph="&#xE72C;" FontSize="13" />
                                            </Button>
                                            <Button Tag="{x:Bind Id}"
                                                    Click="OnCancelTimerClicked"
                                                    Background="Transparent"
                                                    BorderBrush="Transparent"
                                                    Padding="6">
                                                <FontIcon Glyph="&#xE711;" FontSize="13" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- 1: Stopwatch Panel -->
            <Grid Visibility="{x:Bind GetTabVisibility(ViewModel.SelectedTabIndex, 1), Mode=OneWay}"
                  RowSpacing="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Large Digits -->
                <TextBlock Grid.Row="0"
                           Text="{x:Bind ViewModel.StopwatchDisplay, Mode=OneWay}"
                           FontSize="40"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,16,0,8" />

                <!-- Controls -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
                    <Button Content="Start"
                            Command="{x:Bind ViewModel.StartStopwatchCommand}"
                            Style="{ThemeResource AccentButtonStyle}"
                            Width="70" />
                    <Button Content="Pause"
                            Command="{x:Bind ViewModel.PauseStopwatchCommand}"
                            Width="70" />
                    <Button Content="Lap"
                            Command="{x:Bind ViewModel.LapStopwatchCommand}"
                            Width="70" />
                    <Button Content="Reset"
                            Command="{x:Bind ViewModel.ResetStopwatchCommand}"
                            Width="70" />
                </StackPanel>

                <!-- Laps -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.StopwatchLaps, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:LapItem">
                                <Grid Margin="4,2" Padding="8,6" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Bind LapNumber}" FontWeight="SemiBold" FontSize="12" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind FormattedLapTime}" HorizontalAlignment="Center" FontSize="12" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind FormattedSplitTime}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- 2: Pomodoro Panel -->
            <Grid Visibility="{x:Bind GetTabVisibility(ViewModel.SelectedTabIndex, 2), Mode=OneWay}"
                  RowSpacing="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" HorizontalAlignment="Center" Spacing="4" Margin="0,16,0,0">
                    <TextBlock Text="{x:Bind ViewModel.PomodoroPhaseText, Mode=OneWay}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.PomodoroSessionText, Mode=OneWay}"
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <TextBlock Grid.Row="1"
                           Text="{x:Bind ViewModel.PomodoroDisplay, Mode=OneWay}"
                           FontSize="48"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,8" />

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
                    <Button Content="Start"
                            Command="{x:Bind ViewModel.StartPomodoroCommand}"
                            Style="{ThemeResource AccentButtonStyle}"
                            Width="80" />
                    <Button Content="Pause"
                            Command="{x:Bind ViewModel.PausePomodoroCommand}"
                            Width="80" />
                    <Button Content="Reset"
                            Command="{x:Bind ViewModel.ResetPomodoroCommand}"
                            Width="80" />
                    <Button Content="Skip"
                            Command="{x:Bind ViewModel.SkipPomodoroCommand}"
                            Width="80" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
