<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="QuickDock.App.Views.CalendarView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:QuickDock.Core.Models"
    xmlns:vm="using:QuickDock.App.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid RowSpacing="10">
        <Grid.RowDefinitions>
            <!-- Header bar with Back button -->
            <RowDefinition Height="Auto" />
            <!-- Month bar & Quick Date navigation -->
            <RowDefinition Height="Auto" />
            <!-- Content: Split between Date picker and Events list -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="4,0,4,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Command="{x:Bind MainViewModel.OpenHomeCommand, Mode=OneWay}"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Padding="8"
                    CornerRadius="6"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE72B;" FontSize="14" />
                    <TextBlock Text="Back" FontSize="13" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <TextBlock Grid.Column="1"
                       Text="Calendar &amp; Agenda"
                       FontSize="16"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Margin="12,0,0,0" />
        </Grid>

        <!-- Month Navigation Bar -->
        <Grid Grid.Row="1" Margin="4,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                <Button Command="{x:Bind ViewModel.PreviousMonthCommand}" Background="Transparent" BorderBrush="Transparent" Padding="6">
                    <FontIcon Glyph="&#xE76B;" FontSize="13" />
                </Button>
                <TextBlock Text="{x:Bind ViewModel.CurrentMonthYearText, Mode=OneWay}"
                           FontSize="15"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <Button Command="{x:Bind ViewModel.NextMonthCommand}" Background="Transparent" BorderBrush="Transparent" Padding="6">
                    <FontIcon Glyph="&#xE76C;" FontSize="13" />
                </Button>
            </StackPanel>

            <Button Grid.Column="2"
                    Content="Today"
                    Command="{x:Bind ViewModel.TodayCommand}"
                    Padding="12,4"
                    CornerRadius="6" />
        </Grid>

        <!-- Main Content -->
        <Grid Grid.Row="2" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: Add Event Form -->
            <Border Grid.Column="0"
                    Padding="12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <StackPanel Spacing="10">
                    <TextBlock Text="ADD EVENT"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <TextBox Text="{x:Bind ViewModel.NewEventTitle, Mode=TwoWay}"
                             PlaceholderText="Event title..."
                             CornerRadius="6" />

                    <TextBox Text="{x:Bind ViewModel.NewEventDescription, Mode=TwoWay}"
                             PlaceholderText="Description (optional)..."
                             CornerRadius="6" />

                    <TextBlock Text="Selected Date:" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.FormattedSelectedDate, Mode=OneWay}"
                               FontSize="13"
                               FontWeight="SemiBold" />

                    <Button Content="Save Event"
                            Command="{x:Bind ViewModel.AddEventCommand}"
                            Style="{ThemeResource AccentButtonStyle}"
                            HorizontalAlignment="Stretch"
                            CornerRadius="6"
                            Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <!-- Right: Events for selected date -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="10">
                    <TextBlock Text="EVENTS FOR THIS DAY"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <ItemsControl ItemsSource="{x:Bind ViewModel.SelectedDateEvents, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:CalendarEventItem">
                                <Border Margin="0,0,0,8"
                                        Padding="12,10"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" FontSize="14" />
                                            <TextBlock Text="{x:Bind FormattedTime}"
                                                       FontSize="12"
                                                       Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                            <TextBlock Text="{x:Bind Description}"
                                                       FontSize="12"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>

                                        <Button Grid.Column="1"
                                                Tag="{x:Bind}"
                                                Click="OnDeleteEventClicked"
                                                Background="Transparent"
                                                BorderBrush="Transparent"
                                                Padding="6"
                                                VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE74D;" FontSize="13" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>

