<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="QuickDock.App.Views.FileShelfView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:QuickDock.Core.Models"
    xmlns:vm="using:QuickDock.App.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid RowSpacing="10">
        <Grid.RowDefinitions>
            <!-- Header bar with Back button -->
            <RowDefinition Height="Auto" />
            <!-- Actions bar & Drop zone -->
            <RowDefinition Height="Auto" />
            <!-- Items list & Preview splitter -->
            <RowDefinition Height="*" />
            <!-- Status footer -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="4,0,4,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Command="{x:Bind MainViewModel.OpenHomeCommand, Mode=OneWay}"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Padding="8"
                    CornerRadius="6"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE72B;" FontSize="14" />
                    <TextBlock Text="Back" FontSize="13" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <TextBlock Grid.Column="1"
                       Text="File Shelf"
                       FontSize="16"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Margin="12,0,0,0" />

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                <Button Content="Remove Missing"
                        Command="{x:Bind ViewModel.RemoveMissingCommand, Mode=OneWay}"
                        FontSize="11"
                        Padding="8,4"
                        CornerRadius="4" />
                <Button Content="Clear All"
                        Command="{x:Bind ViewModel.ClearShelfCommand, Mode=OneWay}"
                        FontSize="11"
                        Padding="8,4"
                        CornerRadius="4" />
            </StackPanel>
        </Grid>

        <!-- Drag & Drop Zone -->
        <Border Grid.Row="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                Padding="16"
                AllowDrop="True"
                DragOver="OnDragOver"
                Drop="OnDrop">
            <StackPanel HorizontalAlignment="Center" Spacing="4">
                <FontIcon Glyph="&#xE8B7;" FontSize="24" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="Drop files or folders here" FontWeight="Medium" FontSize="13" HorizontalAlignment="Center" />
                <TextBlock Text="Items are referenced temporarily without duplicating disk space." FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Main Content (List + Optional Preview) -->
        <Grid Grid.Row="2" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- File List -->
            <ListView Grid.Column="0"
                      ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                      SelectedItem="{x:Bind ViewModel.SelectedItem, Mode=TwoWay}"
                      SelectionMode="Single"
                      CornerRadius="8"
                      Padding="0,4">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:FileShelfItem">
                        <Grid Padding="8,6"
                              CornerRadius="6"
                              CanDrag="True"
                              DragStarting="OnItemDragStarting"
                              ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Icon / Type -->
                            <Border Grid.Column="0"
                                    Width="32" Height="32"
                                    CornerRadius="4"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE8A5;" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <!-- Name, size, time -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{x:Bind Name}" FontWeight="Medium" FontSize="13" TextTrimming="CharacterEllipsis" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{x:Bind FormattedSize}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="•" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    <TextBlock Text="{x:Bind FormattedTime}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <Border Visibility="{x:Bind IsMissing, Mode=OneTime}"
                                            Background="#4A1C1C"
                                            Padding="4,1"
                                            CornerRadius="3">
                                        <TextBlock Text="Missing" FontSize="10" Foreground="#FF6B6B" />
                                    </Border>
                                </StackPanel>
                            </StackPanel>

                            <!-- Actions -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <Button ToolTipService.ToolTip="Preview"
                                        Click="OnPreviewClicked"
                                        Padding="6" Background="Transparent" BorderBrush="Transparent">
                                    <FontIcon Glyph="&#xE890;" FontSize="13" />
                                </Button>
                                <Button ToolTipService.ToolTip="Open File"
                                        Click="OnOpenClicked"
                                        Padding="6" Background="Transparent" BorderBrush="Transparent">
                                    <FontIcon Glyph="&#xE8A7;" FontSize="13" />
                                </Button>
                                <Button ToolTipService.ToolTip="Reveal in Explorer"
                                        Click="OnRevealClicked"
                                        Padding="6" Background="Transparent" BorderBrush="Transparent">
                                    <FontIcon Glyph="&#xEC50;" FontSize="13" />
                                </Button>
                                <Button ToolTipService.ToolTip="Copy Path"
                                        Click="OnCopyPathClicked"
                                        Padding="6" Background="Transparent" BorderBrush="Transparent">
                                    <FontIcon Glyph="&#xE8C8;" FontSize="13" />
                                </Button>
                                <Button ToolTipService.ToolTip="Remove from Shelf"
                                        Click="OnRemoveClicked"
                                        Padding="6" Background="Transparent" BorderBrush="Transparent">
                                    <FontIcon Glyph="&#xE74D;" FontSize="13" Foreground="#E06C75" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Preview Panel -->
            <Border Grid.Column="1"
                    Width="240"
                    Visibility="{x:Bind ViewModel.IsPreviewOpen, Mode=OneWay}"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Preview Header -->
                    <Grid Grid.Row="0">
                        <TextBlock Text="File Preview" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                        <Button HorizontalAlignment="Right"
                                Command="{x:Bind ViewModel.ClosePreviewCommand, Mode=OneWay}"
                                Background="Transparent" BorderBrush="Transparent" Padding="4">
                            <FontIcon Glyph="&#xE711;" FontSize="11" />
                        </Button>
                    </Grid>

                    <!-- Preview Body -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{x:Bind ViewModel.ActivePreview.Name, Mode=OneWay}"
                                       FontWeight="Medium" FontSize="12" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind ViewModel.ActivePreview.FormattedSize, Mode=OneWay}"
                                       FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.ActivePreview.Dimensions, Mode=OneWay}"
                                       FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                            <!-- Text Content -->
                            <TextBox Text="{x:Bind ViewModel.ActivePreview.TextContent, Mode=OneWay}"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     FontFamily="Consolas"
                                     FontSize="11"
                                     MaxHeight="260"
                                     CornerRadius="4" />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Send Actions -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                        <Button Content="QuickDrop"
                                Command="{x:Bind ViewModel.SendToQuickDropCommand, Mode=OneWay}"
                                CommandParameter="{x:Bind ViewModel.SelectedItem, Mode=OneWay}"
                                FontSize="11" Padding="8,4" />
                        <Button Content="Convert"
                                Command="{x:Bind ViewModel.SendToConverterCommand, Mode=OneWay}"
                                CommandParameter="{x:Bind ViewModel.SelectedItem, Mode=OneWay}"
                                FontSize="11" Padding="8,4" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Status Footer -->
        <TextBlock Grid.Row="3"
                   Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                   FontSize="11"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Margin="4,0" />
    </Grid>
</UserControl>
