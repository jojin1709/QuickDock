<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="QuickDock.App.Views.ScreenTimeView"
    x:Name="RootScreenTimeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:QuickDock.App.Controls"
    xmlns:vm="using:QuickDock.App.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Margin="16,8,16,10" ColumnSpacing="12">
        <Grid.ColumnDefinitions>
            <!-- Left Side: Today (top) + Last 7 Days (bottom) -->
            <ColumnDefinition Width="*" />
            <!-- Right Side: By App Breakdown -->
            <ColumnDefinition Width="340" />
        </Grid.ColumnDefinitions>

        <!-- LEFT COLUMN: 2 Cards -->
        <Grid Grid.Column="0" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- CARD 1: TODAY -->
            <Border Grid.Row="0"
                    Background="#141417"
                    BorderBrush="#222226"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="16,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE9D9;" FontSize="11" Foreground="#A1A1AA" />
                        <TextBlock Text="Today" FontSize="12" FontWeight="SemiBold" Foreground="#E4E4E7" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- 3 Horizontal Columns: Screen Time, Limit Ring, Apps Used -->
                    <Grid Grid.Row="1" Margin="0,8,0,0" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Screen Time -->
                        <StackPanel Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.TotalTimeText, Mode=OneWay}"
                                       FontSize="28" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" />
                            <TextBlock Text="Screen time" FontSize="11" Foreground="#8E8E93" HorizontalAlignment="Center" Margin="0,2,0,0" />
                        </StackPanel>

                        <!-- Limit Progress Ring -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="12,0,12,0">
                            <Grid Width="38" Height="38">
                                <Ellipse Width="38" Height="38" Stroke="#27272A" StrokeThickness="3" />
                                <Ellipse Width="38" Height="38" Stroke="#FFFFFF" StrokeThickness="3" StrokeDashArray="3.5 1" />
                            </Grid>
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="{x:Bind ViewModel.LimitRemainingText, Mode=OneWay}" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" />
                                    <FontIcon Glyph="&#xE70F;" FontSize="10" Foreground="#71717A" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="left of 7h limit" FontSize="11" Foreground="#8E8E93" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Apps Used -->
                        <StackPanel Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.AppsUsedCount, Mode=OneWay}" FontSize="28" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" />
                            <TextBlock Text="Apps used" FontSize="11" Foreground="#8E8E93" HorizontalAlignment="Center" Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- CARD 2: LAST 7 DAYS -->
            <Border Grid.Row="1"
                    Background="#141417"
                    BorderBrush="#222226"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="16,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE787;" FontSize="11" Foreground="#A1A1AA" />
                            <TextBlock Text="Last 7 days" FontSize="12" FontWeight="SemiBold" Foreground="#E4E4E7" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                            <TextBlock Text="avg &lt;1m" FontSize="10" Foreground="#71717A" HorizontalAlignment="Right" />
                            <TextBlock Text="{x:Bind ViewModel.WeeklyAverageText, Mode=OneWay}" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Right" />
                        </StackPanel>
                    </Grid>

                    <!-- Days Sparkline Bars -->
                    <ItemsControl Grid.Row="1" ItemsSource="{x:Bind ViewModel.WeekDays, Mode=OneWay}" Margin="0,12,0,4" VerticalAlignment="Bottom">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="18" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:DaySparklineItem">
                                <StackPanel HorizontalAlignment="Center" Spacing="8">
                                    <Border Width="12" Height="{x:Bind BarHeight}"
                                            Background="{x:Bind SparklineColor}"
                                            CornerRadius="2"
                                            VerticalAlignment="Bottom" />
                                    <TextBlock Text="{x:Bind DayName}"
                                               FontSize="10"
                                               Foreground="{x:Bind DayTextColor}"
                                               HorizontalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>
        </Grid>

        <!-- RIGHT COLUMN: BY APP -->
        <Border Grid.Column="1"
                Background="#141417"
                BorderBrush="#222226"
                BorderThickness="1"
                CornerRadius="16"
                Padding="16,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE9D9;" FontSize="11" Foreground="#A1A1AA" />
                        <TextBlock Text="By app" FontSize="12" FontWeight="SemiBold" Foreground="#E4E4E7" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Grid.Column="1" Background="Transparent" BorderBrush="Transparent" Padding="4" Click="OnToggleViewModeClicked">
                        <FontIcon Glyph="&#xE72C;" FontSize="11" Foreground="#71717A" />
                    </Button>
                </Grid>

                <!-- App List -->
                <ScrollViewer Grid.Row="1" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="10">
                        <!-- Empty State if no usage recorded -->
                        <StackPanel Visibility="{x:Bind GetEmptyVisibility(ViewModel.AppUsages.Count), Mode=OneWay}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Margin="0,40,0,0"
                                    Spacing="8">
                            <FontIcon Glyph="&#xE9D9;" FontSize="32" Foreground="#71717A" HorizontalAlignment="Center" />
                            <TextBlock Text="No activity recorded yet today" FontSize="13" FontWeight="SemiBold" Foreground="#A1A1AA" HorizontalAlignment="Center" />
                            <TextBlock Text="Active app time will appear here automatically." FontSize="11" Foreground="#71717A" HorizontalAlignment="Center" />
                        </StackPanel>

                        <!-- Live Recorded Apps -->
                        <ItemsControl ItemsSource="{x:Bind ViewModel.AppUsages, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:AppUsageDisplayItem">
                                    <StackPanel Spacing="3" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Grid.Column="0" Glyph="{x:Bind IconGlyph}" FontSize="14" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind AppName}" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="8,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                                <TextBlock Text="{x:Bind DurationText}" FontSize="11" Foreground="#FFFFFF" HorizontalAlignment="Right" />
                                                <TextBlock Text="{x:Bind PercentageText}" FontSize="9" Foreground="#71717A" HorizontalAlignment="Right" />
                                            </StackPanel>
                                        </Grid>
                                        <ProgressBar Value="{x:Bind Percentage}" Maximum="100" Height="3" Foreground="#FFFFFF" Background="#27272A" Margin="22,2,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
