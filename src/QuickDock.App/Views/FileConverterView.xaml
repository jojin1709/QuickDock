<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="QuickDock.App.Views.FileConverterView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:QuickDock.Core.Models"
    xmlns:vm="using:QuickDock.App.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <!-- Header bar with Back button -->
            <RowDefinition Height="Auto" />
            <!-- Source File Selection -->
            <RowDefinition Height="Auto" />
            <!-- Conversion Options -->
            <RowDefinition Height="Auto" />
            <!-- Progress & Actions -->
            <RowDefinition Height="Auto" />
            <!-- Status & Results -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="4,0,4,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Command="{x:Bind MainViewModel.OpenHomeCommand, Mode=OneWay}"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Padding="8"
                    CornerRadius="6"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE72B;" FontSize="14" />
                    <TextBlock Text="Back" FontSize="13" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <TextBlock Grid.Column="1"
                       Text="File Converter"
                       FontSize="16"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Margin="12,0,0,0" />
        </Grid>

        <!-- Source File Section -->
        <Border Grid.Row="1"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16"
                AllowDrop="True"
                DragOver="OnDragOver"
                Drop="OnDrop">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <FontIcon Grid.Column="0" Glyph="&#xE8B7;" FontSize="28" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                    <TextBlock Text="{x:Bind ViewModel.FileName, Mode=OneWay}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{x:Bind ViewModel.FormattedSize, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="Drop a file here or browse" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </StackPanel>

                <Button Grid.Column="2"
                        Content="Browse..."
                        Click="OnBrowseFileClicked"
                        VerticalAlignment="Center"
                        FontSize="12" Padding="12,6" CornerRadius="4" />
            </Grid>
        </Border>

        <!-- Target Format & Settings -->
        <Border Grid.Row="2"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
            <StackPanel Spacing="12">
                <TextBlock Text="Conversion Target" FontWeight="SemiBold" FontSize="13" />

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ComboBox Grid.Column="0"
                              Header="Target Format"
                              ItemsSource="{x:Bind ViewModel.AvailableFormats, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SelectedTargetFormat, Mode=TwoWay}"
                              HorizontalAlignment="Stretch" />

                    <!-- Quality Slider (visible for image conversion) -->
                    <StackPanel Grid.Column="1"
                                Visibility="{x:Bind ViewModel.IsImageConversion, Mode=OneWay}"
                                Spacing="4" VerticalAlignment="Bottom">
                        <Grid>
                            <TextBlock Text="Image Quality" FontSize="12" />
                            <TextBlock Text="{x:Bind ViewModel.Quality, Mode=OneWay}" HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold" />
                        </Grid>
                        <Slider Value="{x:Bind ViewModel.Quality, Mode=TwoWay}" Minimum="10" Maximum="100" StepFrequency="5" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Progress & Action -->
        <StackPanel Grid.Row="3" Spacing="8">
            <Button Content="Convert File"
                    Command="{x:Bind ViewModel.ConvertCommand, Mode=OneWay}"
                    IsEnabled="{x:Bind ViewModel.IsNotConverting, Mode=OneWay}"
                    Style="{StaticResource AccentButtonStyle}"
                    HorizontalAlignment="Stretch"
                    Height="36"
                    CornerRadius="6" />

            <ProgressBar Value="{x:Bind ViewModel.Progress, Mode=OneWay}"
                         Maximum="100"
                         Visibility="{x:Bind ViewModel.IsConverting, Mode=OneWay}"
                         Height="6"
                         CornerRadius="3" />
        </StackPanel>

        <!-- Status & Results -->
        <Border Grid.Row="4"
                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                CornerRadius="6"
                Padding="12,10">
            <StackPanel Spacing="6">
                <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                           FontSize="12"
                           TextWrapping="Wrap" />

                <Button Content="Reveal Converted File in Explorer"
                        Click="OnRevealResultClicked"
                        Visibility="{x:Bind ViewModel.HasLastOutputFile, Mode=OneWay}"
                        FontSize="11" Padding="8,4" CornerRadius="4" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
