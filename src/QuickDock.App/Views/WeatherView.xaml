<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="QuickDock.App.Views.WeatherView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:QuickDock.App.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <!-- Header bar with Back button -->
            <RowDefinition Height="Auto" />
            <!-- Location search bar -->
            <RowDefinition Height="Auto" />
            <!-- Weather cards -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="4,0,4,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Command="{x:Bind MainViewModel.OpenHomeCommand, Mode=OneWay}"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Padding="8"
                    CornerRadius="6"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE72B;" FontSize="14" />
                    <TextBlock Text="Back" FontSize="13" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <TextBlock Grid.Column="1"
                       Text="Weather"
                       FontSize="16"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Margin="12,0,0,0" />

            <TextBlock Grid.Column="2"
                       Text="{x:Bind ViewModel.CacheBadgeText, Mode=OneWay}"
                       FontSize="11"
                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0" />
        </Grid>

        <!-- Location Search Bar -->
        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0"
                     x:Name="CityInputTextBox"
                     PlaceholderText="Enter city name (e.g. Thrissur, London)..."
                     Text="{x:Bind ViewModel.ManualCityInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     KeyDown="OnCityInputKeyDown"
                     CornerRadius="6" />

            <Button Grid.Column="1"
                    Content="Update"
                    Command="{x:Bind ViewModel.UpdateManualLocationCommand}"
                    CornerRadius="6" />
        </Grid>

        <!-- Weather Display Card -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12">
                <Border Padding="18"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="10">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Location & Condition -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="{x:Bind ViewModel.LocationName, Mode=OneWay}"
                                           FontSize="20"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind ViewModel.ConditionText, Mode=OneWay}"
                                           FontSize="14"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind ViewModel.TemperatureText, Mode=OneWay}"
                                       FontSize="40"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <Border Grid.Row="1" Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="0,4" />

                        <!-- Atmospheric Details -->
                        <Grid Grid.Row="2" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="FEELS LIKE" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.FeelsLikeText, Mode=OneWay}" FontSize="13" FontWeight="Medium" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="HUMIDITY" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.HumidityText, Mode=OneWay}" FontSize="13" FontWeight="Medium" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Spacing="2">
                                <TextBlock Text="WIND" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.WindText, Mode=OneWay}" FontSize="13" FontWeight="Medium" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                           FontSize="12"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>

