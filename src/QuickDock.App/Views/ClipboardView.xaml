<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="QuickDock.App.Views.ClipboardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:QuickDock.Core.Models"
    xmlns:vm="using:QuickDock.App.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid RowSpacing="10">
        <Grid.RowDefinitions>
            <!-- Search & Actions -->
            <RowDefinition Height="Auto" />
            <!-- History Content -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Search and Action Bar -->
        <Grid Grid.Row="0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0"
                     PlaceholderText="Search clipboard..."
                     Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     CornerRadius="6" />

            <!-- Pause / Resume Toggle -->
            <Button Grid.Column="1"
                    Command="{x:Bind ViewModel.TogglePauseCommand}"
                    Background="Transparent"
                    BorderBrush="#27272A"
                    Padding="8,6"
                    CornerRadius="6">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="{x:Bind ViewModel.PauseButtonGlyph, Mode=OneWay}" FontSize="12" />
                    <TextBlock Text="{x:Bind ViewModel.PauseButtonText, Mode=OneWay}" FontSize="12" />
                </StackPanel>
            </Button>

            <Button Grid.Column="2"
                    Content="Clear"
                    Command="{x:Bind ViewModel.ClearHistoryCommand}"
                    CornerRadius="6" />
        </Grid>

        <!-- Items View -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12">
                <!-- Empty State -->
                <StackPanel Visibility="{x:Bind GetBoolVisibility(ViewModel.IsEmpty), Mode=OneWay}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="0,50,0,0"
                            Spacing="10">
                    <FontIcon Glyph="&#xF0E3;" FontSize="36" Foreground="#71717A" HorizontalAlignment="Center" />
                    <TextBlock Text="Clipboard is Empty" FontSize="15" FontWeight="SemiBold" Foreground="#A1A1AA" HorizontalAlignment="Center" />
                    <TextBlock Text="Copied text, links, and screenshots will appear here." FontSize="11" Foreground="#71717A" HorizontalAlignment="Center" />
                </StackPanel>

                <!-- Pinned Items -->
                <TextBlock Text="PINNED"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Visibility="{x:Bind GetBoolVisibility(ViewModel.HasPinnedItems), Mode=OneWay}" />

                <ItemsControl ItemsSource="{x:Bind ViewModel.PinnedItems, Mode=OneWay}"
                              Visibility="{x:Bind GetBoolVisibility(ViewModel.HasPinnedItems), Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:ClipboardItem">
                            <Border Margin="0,0,0,6"
                                    Padding="10,8"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Thumbnail for copied images -->
                                    <Border Grid.Column="0"
                                            Width="38"
                                            Height="38"
                                            CornerRadius="4"
                                            Background="#27272A"
                                            Visibility="{x:Bind ThumbnailVisibility}">
                                        <Image Source="{x:Bind ImageThumbnailPath}" Stretch="UniformToFill" />
                                    </Border>

                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Preview}"
                                                   FontSize="13"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxLines="2" />
                                        <TextBlock Text="{x:Bind FormattedTime}"
                                                   FontSize="10"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <Button Tag="{x:Bind}"
                                                Click="OnCopyItemClicked"
                                                Background="Transparent"
                                                BorderBrush="Transparent"
                                                Padding="6">
                                            <FontIcon Glyph="&#xE8C8;" FontSize="13" />
                                        </Button>
                                        <Button Tag="{x:Bind}"
                                                Click="OnTogglePinClicked"
                                                Background="Transparent"
                                                BorderBrush="Transparent"
                                                Padding="6">
                                            <FontIcon Glyph="&#xE718;" FontSize="13" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                        </Button>
                                        <Button Tag="{x:Bind}"
                                                Click="OnDeleteItemClicked"
                                                Background="Transparent"
                                                BorderBrush="Transparent"
                                                Padding="6">
                                            <FontIcon Glyph="&#xE74D;" FontSize="13" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Recent Items -->
                <TextBlock Text="RECENT"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Visibility="{x:Bind GetBoolVisibility(ViewModel.HasRecentItems), Mode=OneWay}" />

                <ItemsControl ItemsSource="{x:Bind ViewModel.RecentItems, Mode=OneWay}"
                              Visibility="{x:Bind GetBoolVisibility(ViewModel.HasRecentItems), Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:ClipboardItem">
                            <Border Margin="0,0,0,6"
                                    Padding="10,8"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Thumbnail for copied images -->
                                    <Border Grid.Column="0"
                                            Width="38"
                                            Height="38"
                                            CornerRadius="4"
                                            Background="#27272A"
                                            Visibility="{x:Bind ThumbnailVisibility}">
                                        <Image Source="{x:Bind ImageThumbnailPath}" Stretch="UniformToFill" />
                                    </Border>

                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Preview}"
                                                   FontSize="13"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxLines="2" />
                                        <TextBlock Text="{x:Bind FormattedTime}"
                                                   FontSize="10"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <Button Tag="{x:Bind}"
                                                Click="OnCopyItemClicked"
                                                Background="Transparent"
                                                BorderBrush="Transparent"
                                                Padding="6">
                                            <FontIcon Glyph="&#xE8C8;" FontSize="13" />
                                        </Button>
                                        <Button Tag="{x:Bind}"
                                                Click="OnTogglePinClicked"
                                                Background="Transparent"
                                                BorderBrush="Transparent"
                                                Padding="6">
                                            <FontIcon Glyph="&#xE718;" FontSize="13" />
                                        </Button>
                                        <Button Tag="{x:Bind}"
                                                Click="OnDeleteItemClicked"
                                                Background="Transparent"
                                                BorderBrush="Transparent"
                                                Padding="6">
                                            <FontIcon Glyph="&#xE74D;" FontSize="13" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
