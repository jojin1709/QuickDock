<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="QuickDock.App.Views.ClipboardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:QuickDock.Core.Models"
    xmlns:vm="using:QuickDock.App.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid RowSpacing="10">
        <Grid.RowDefinitions>
            <!-- Header bar with Back button -->
            <RowDefinition Height="Auto" />
            <!-- Search & Actions -->
            <RowDefinition Height="Auto" />
            <!-- History Content -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="4,0,4,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Command="{x:Bind MainViewModel.OpenHomeCommand, Mode=OneWay}"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Padding="8"
                    CornerRadius="6"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE72B;" FontSize="14" />
                    <TextBlock Text="Back" FontSize="13" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <TextBlock Grid.Column="1"
                       Text="Clipboard Manager"
                       FontSize="16"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Margin="12,0,0,0" />

            <!-- Pause / Resume Toggle -->
            <Button Grid.Column="2"
                    Command="{x:Bind ViewModel.TogglePauseCommand}"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Padding="6,4"
                    CornerRadius="6">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="{x:Bind ViewModel.PauseButtonGlyph, Mode=OneWay}" FontSize="13" />
                    <TextBlock Text="{x:Bind ViewModel.PauseButtonText, Mode=OneWay}" FontSize="12" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Search and Action Bar -->
        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0"
                     PlaceholderText="Search clipboard..."
                     Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     CornerRadius="6" />

            <Button Grid.Column="1"
                    Content="Clear"
                    Command="{x:Bind ViewModel.ClearHistoryCommand}"
                    CornerRadius="6" />
        </Grid>

        <!-- Items View -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12">
                <!-- Pinned Items -->
                <TextBlock Text="PINNED"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                <ItemsControl ItemsSource="{x:Bind ViewModel.PinnedItems, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:ClipboardItem">
                            <Border Margin="0,0,0,6"
                                    Padding="10,8"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="{x:Bind Preview}"
                                                   FontSize="13"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxLines="2" />
                                        <TextBlock Text="{x:Bind FormattedTime}"
                                                   FontSize="10"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                        <Button Tag="{x:Bind}"
                                                Click="OnCopyItemClicked"
                                                Background="Transparent"
                                                BorderBrush="Transparent"
                                                Padding="6">
                                            <FontIcon Glyph="&#xE8C8;" FontSize="13" />
                                        </Button>
                                        <Button Tag="{x:Bind}"
                                                Click="OnTogglePinClicked"
                                                Background="Transparent"
                                                BorderBrush="Transparent"
                                                Padding="6">
                                            <FontIcon Glyph="&#xE718;" FontSize="13" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                        </Button>
                                        <Button Tag="{x:Bind}"
                                                Click="OnDeleteItemClicked"
                                                Background="Transparent"
                                                BorderBrush="Transparent"
                                                Padding="6">
                                            <FontIcon Glyph="&#xE74D;" FontSize="13" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Recent Items -->
                <TextBlock Text="RECENT"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                <ItemsControl ItemsSource="{x:Bind ViewModel.RecentItems, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:ClipboardItem">
                            <Border Margin="0,0,0,6"
                                    Padding="10,8"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="{x:Bind Preview}"
                                                   FontSize="13"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxLines="2" />
                                        <TextBlock Text="{x:Bind FormattedTime}"
                                                   FontSize="10"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                        <Button Tag="{x:Bind}"
                                                Click="OnCopyItemClicked"
                                                Background="Transparent"
                                                BorderBrush="Transparent"
                                                Padding="6">
                                            <FontIcon Glyph="&#xE8C8;" FontSize="13" />
                                        </Button>
                                        <Button Tag="{x:Bind}"
                                                Click="OnTogglePinClicked"
                                                Background="Transparent"
                                                BorderBrush="Transparent"
                                                Padding="6">
                                            <FontIcon Glyph="&#xE718;" FontSize="13" />
                                        </Button>
                                        <Button Tag="{x:Bind}"
                                                Click="OnDeleteItemClicked"
                                                Background="Transparent"
                                                BorderBrush="Transparent"
                                                Padding="6">
                                            <FontIcon Glyph="&#xE74D;" FontSize="13" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
