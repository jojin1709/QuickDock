<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="QuickDock.App.Views.SettingsView"
    x:Name="RootSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:QuickDock.App.Controls"
    xmlns:vm="using:QuickDock.App.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="#0A0A0C">
        <Grid.ColumnDefinitions>
            <!-- Left Sidebar (width ~230) -->
            <ColumnDefinition Width="230" />
            <!-- Divider -->
            <ColumnDefinition Width="1" />
            <!-- Right Content Area -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ==================== LEFT SIDEBAR ==================== -->
        <Grid Grid.Column="0" Margin="14,16,14,16" RowSpacing="12">
            <Grid.RowDefinitions>
                <!-- Brand Header -->
                <RowDefinition Height="Auto" />
                <!-- Search Box -->
                <RowDefinition Height="Auto" />
                <!-- Navigation Items -->
                <RowDefinition Height="*" />
                <!-- Footer Info -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Brand Header: QuickDock Logo + App Name -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="4,4,4,8">
                <controls:QuickDockIcon Width="26" Height="26" VerticalAlignment="Center" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="QuickDock" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" />
                </StackPanel>
            </StackPanel>

            <!-- Search Box with Ctrl K -->
            <Grid Grid.Row="1">
                <TextBox PlaceholderText="Search"
                         Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Background="#141417"
                         BorderBrush="#222226"
                         BorderThickness="1"
                         CornerRadius="8"
                         Padding="10,6,40,6"
                         FontSize="12" />
                <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                        Background="#222226" CornerRadius="4" Padding="5,2" Margin="0,0,8,0">
                    <TextBlock Text="Ctrl K" FontSize="10" Foreground="#8E8E93" />
                </Border>
            </Grid>

            <!-- Navigation Items -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.NavItems, Mode=OneWay}">
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:SettingsNavItem">
                            <Button Command="{Binding ElementName=RootSettingsView, Path=ViewModel.SelectSectionCommand}"
                                    CommandParameter="{x:Bind Key}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    Padding="10,8"
                                    Margin="0,2"
                                    CornerRadius="8">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="{x:Bind IconGlyph}" FontSize="14" Foreground="#FFFFFF" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Title}" FontSize="13" FontWeight="Medium" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>

            <!-- Footer: Help, Feedback, v1.0.0 -->
            <StackPanel Grid.Row="3" Spacing="4" Margin="4,8,4,0">
                <TextBlock Text="Help · Feedback · v1.0.0" FontSize="11" Foreground="#71717A" />
            </StackPanel>
        </Grid>

        <!-- Divider Line -->
        <Border Grid.Column="1" Background="#1C1C1F" />

        <!-- ==================== RIGHT CONTENT PANE ==================== -->
        <ScrollViewer Grid.Column="2" Padding="28,24,28,24" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="24">

                <!-- ==================== SECTION 1: GENERAL ==================== -->
                <StackPanel Spacing="20" Visibility="{x:Bind IsSectionVisible(ViewModel.SelectedSection, 'General'), Mode=OneWay}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="General" FontSize="26" FontWeight="Bold" Foreground="#FFFFFF" />
                        <TextBlock Text="Startup, shortcut, time and units" FontSize="12" Foreground="#8E8E93" />
                    </StackPanel>

                    <!-- Start QuickDock when Windows starts -->
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,16,0">
                            <TextBlock Text="Start QuickDock when Windows starts" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF" />
                            <TextBlock Text="Starts silently each time you sign in. To have it back seconds after a restart, turn on 'Restart apps' in Windows Settings > Accounts > Sign-in options."
                                       FontSize="11" Foreground="#8E8E93" TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.StartWithWindows, Mode=TwoWay}"
                                      OnContent="" OffContent="" VerticalAlignment="Center" />
                    </Grid>

                    <!-- Open the notch -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="Open the notch" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF" />
                            <TextBlock Text="Opens or closes the notch from anywhere" FontSize="11" Foreground="#8E8E93" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Border Background="#1C1C1F" BorderBrush="#27272A" BorderThickness="1" CornerRadius="6" Padding="12,6">
                                <TextBlock Text="{x:Bind ViewModel.GlobalHotkeyText, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" />
                            </Border>
                            <Button Content="Change" Background="#222226" Foreground="#FFFFFF" CornerRadius="6" Padding="12,6" FontSize="12" />
                        </StackPanel>
                    </Grid>

                    <!-- Time format -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="Time format" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF" />
                            <TextBlock Text="Used by the notch, Home and Clock" FontSize="11" Foreground="#8E8E93" />
                        </StackPanel>
                        <Border Grid.Column="1" Background="#141417" BorderBrush="#222226" BorderThickness="1" CornerRadius="8" Padding="2" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <Button x:Name="BtnTimeSystem" Content="System" Click="OnTimeFormatClick" Tag="0" Background="#27272A" Foreground="#FFFFFF" CornerRadius="6" Padding="12,5" FontSize="11" />
                                <Button x:Name="BtnTime12h" Content="12-hour" Click="OnTimeFormatClick" Tag="1" Background="Transparent" Foreground="#8E8E93" CornerRadius="6" Padding="12,5" FontSize="11" />
                                <Button x:Name="BtnTime24h" Content="24-hour" Click="OnTimeFormatClick" Tag="2" Background="Transparent" Foreground="#8E8E93" CornerRadius="6" Padding="12,5" FontSize="11" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Temperature -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="Temperature" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF" />
                            <TextBlock Text="Weather, Home and the notch" FontSize="11" Foreground="#8E8E93" />
                        </StackPanel>
                        <Border Grid.Column="1" Background="#141417" BorderBrush="#222226" BorderThickness="1" CornerRadius="8" Padding="2" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <Button x:Name="BtnTempC" Content="°C" Click="OnTempUnitClick" Tag="0" Background="#27272A" Foreground="#FFFFFF" CornerRadius="6" Padding="16,5" FontSize="11" />
                                <Button x:Name="BtnTempF" Content="°F" Click="OnTempUnitClick" Tag="1" Background="Transparent" Foreground="#8E8E93" CornerRadius="6" Padding="16,5" FontSize="11" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Wind speed -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="Wind speed" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF" />
                            <TextBlock Text="Used by Weather and Home" FontSize="11" Foreground="#8E8E93" />
                        </StackPanel>
                        <Border Grid.Column="1" Background="#141417" BorderBrush="#222226" BorderThickness="1" CornerRadius="8" Padding="2" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <Button x:Name="BtnWindKmh" Content="km/h" Click="OnWindSpeedClick" Tag="0" Background="#27272A" Foreground="#FFFFFF" CornerRadius="6" Padding="14,5" FontSize="11" />
                                <Button x:Name="BtnWindMph" Content="mph" Click="OnWindSpeedClick" Tag="1" Background="Transparent" Foreground="#8E8E93" CornerRadius="6" Padding="14,5" FontSize="11" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Language -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="Language" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF" />
                            <TextBlock Text="More languages are on the way" FontSize="11" Foreground="#8E8E93" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="English" FontSize="13" Foreground="#FFFFFF" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>

                <!-- ==================== SECTION 2: NOTCH ==================== -->
                <StackPanel Spacing="20" Visibility="{x:Bind IsSectionVisible(ViewModel.SelectedSection, 'Notch'), Mode=OneWay}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Notch" FontSize="26" FontWeight="Bold" Foreground="#FFFFFF" />
                        <TextBlock Text="Shape, behavior and live preview" FontSize="12" Foreground="#8E8E93" />
                    </StackPanel>

                    <!-- Live Preview Box -->
                    <Border Background="#121214" BorderBrush="#222226" BorderThickness="1" CornerRadius="12" Height="150" Padding="12">
                        <Grid>
                            <!-- Mini screen top notch preview -->
                            <Border HorizontalAlignment="Center" VerticalAlignment="Top"
                                    Background="#000000" CornerRadius="0,0,10,10" Padding="12,4" Margin="0,-2,0,0">
                                <StackPanel Orientation="Horizontal" Spacing="16">
                                    <TextBlock Text="14:17" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                        <Border Width="14" Height="7" CornerRadius="2" BorderThickness="1" BorderBrush="#88FFFFFF">
                                            <Border Width="10" Height="4" Background="#22C55E" HorizontalAlignment="Left" />
                                        </Border>
                                        <TextBlock Text="80" FontSize="9" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Top Right Toggle: Resting / Hover -->
                            <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Background="#1C1C1F" BorderBrush="#27272A" BorderThickness="1" CornerRadius="6" Padding="2">
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <Button x:Name="BtnPreviewResting" Content="Resting" Click="OnPreviewModeClick" Tag="0" Background="#27272A" Foreground="#FFFFFF" CornerRadius="4" Padding="10,4" FontSize="10" />
                                    <Button x:Name="BtnPreviewHover" Content="Hover" Click="OnPreviewModeClick" Tag="1" Background="Transparent" Foreground="#8E8E93" CornerRadius="4" Padding="10,4" FontSize="10" />
                                </StackPanel>
                            </Border>

                            <!-- Bottom Left: Preview Badge -->
                            <Border HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                    Background="#1C1C1F" CornerRadius="4" Padding="6,2">
                                <TextBlock Text="Preview" FontSize="9" Foreground="#8E8E93" />
                            </Border>
                        </Grid>
                    </Border>

                    <!-- VISIBILITY Section -->
                    <StackPanel Spacing="10">
                        <TextBlock Text="VISIBILITY" FontSize="11" FontWeight="SemiBold" Foreground="#71717A" CharacterSpacing="50" />
                        <Grid ColumnSpacing="12" RowSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Card 1: Always (Selected) -->
                            <Border x:Name="CardVisibilityAlways" Grid.Row="0" Grid.Column="0" PointerPressed="OnVisibilityCardClick" Tag="0" Background="#141417" BorderBrush="#FFFFFF" BorderThickness="1" CornerRadius="12" Padding="14">
                                <StackPanel Spacing="6" IsHitTestVisible="False">
                                    <TextBlock Text="Always" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" />
                                    <TextBlock Text="Always on screen. Fullscreen rules below still apply." FontSize="11" Foreground="#8E8E93" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- Card 2: Smart -->
                            <Border x:Name="CardVisibilitySmart" Grid.Row="0" Grid.Column="1" PointerPressed="OnVisibilityCardClick" Tag="1" Background="#141417" BorderBrush="#222226" BorderThickness="1" CornerRadius="12" Padding="14">
                                <StackPanel Spacing="6" IsHitTestVisible="False">
                                    <TextBlock Text="Smart" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" />
                                    <TextBlock Text="Full on the desktop; tucked away over maximized apps." FontSize="11" Foreground="#8E8E93" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- Card 3: Minimal -->
                            <Border x:Name="CardVisibilityMinimal" Grid.Row="1" Grid.Column="0" PointerPressed="OnVisibilityCardClick" Tag="2" Background="#141417" BorderBrush="#222226" BorderThickness="1" CornerRadius="12" Padding="14">
                                <StackPanel Spacing="6" IsHitTestVisible="False">
                                    <TextBlock Text="Minimal" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" />
                                    <TextBlock Text="Just a small arrow at the top. Hover to peek, open on hover or click." FontSize="11" Foreground="#8E8E93" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- Card 4: Hidden -->
                            <Border x:Name="CardVisibilityHidden" Grid.Row="1" Grid.Column="1" PointerPressed="OnVisibilityCardClick" Tag="3" Background="#141417" BorderBrush="#222226" BorderThickness="1" CornerRadius="12" Padding="14">
                                <StackPanel Spacing="6" IsHitTestVisible="False">
                                    <TextBlock Text="Hidden" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" />
                                    <TextBlock Text="Nothing on screen. Open it from the tray icon (or set a shortcut in General)." FontSize="11" Foreground="#8E8E93" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <!-- STYLE Section -->
                    <StackPanel Spacing="10">
                        <TextBlock Text="STYLE" FontSize="11" FontWeight="SemiBold" Foreground="#71717A" CharacterSpacing="50" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Style 1: Line -->
                            <Border x:Name="CardStyleLine" Grid.Column="0" PointerPressed="OnStyleCardClick" Tag="0" Background="#141417" BorderBrush="#222226" BorderThickness="1" CornerRadius="12" Padding="14">
                                <StackPanel Spacing="6" IsHitTestVisible="False">
                                    <TextBlock Text="Line" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" />
                                    <TextBlock Text="A slim bar along the top edge" FontSize="11" Foreground="#8E8E93" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- Style 2: Notch (Selected) -->
                            <Border x:Name="CardStyleNotch" Grid.Column="1" PointerPressed="OnStyleCardClick" Tag="1" Background="#141417" BorderBrush="#FFFFFF" BorderThickness="1" CornerRadius="12" Padding="14">
                                <StackPanel Spacing="6" IsHitTestVisible="False">
                                    <TextBlock Text="Notch" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" />
                                    <TextBlock Text="Grows out of the screen edge" FontSize="11" Foreground="#8E8E93" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- Style 3: Island -->
                            <Border x:Name="CardStyleIsland" Grid.Column="2" PointerPressed="OnStyleCardClick" Tag="2" Background="#141417" BorderBrush="#222226" BorderThickness="1" CornerRadius="12" Padding="14">
                                <StackPanel Spacing="6" IsHitTestVisible="False">
                                    <TextBlock Text="Island" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" />
                                    <TextBlock Text="A pill floating just below the edge" FontSize="11" Foreground="#8E8E93" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <!-- Notch shape -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="Notch shape" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF" />
                            <TextBlock Text="Fine-tune the Notch style's silhouette" FontSize="11" Foreground="#8E8E93" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" SelectedIndex="{x:Bind ViewModel.NotchShapeIndex, Mode=TwoWay}" Width="140" Background="#141417" CornerRadius="6">
                            <ComboBoxItem Content="Compact" />
                            <ComboBoxItem Content="Classic" />
                            <ComboBoxItem Content="Wide" />
                        </ComboBox>
                    </Grid>

                    <!-- Size Slider -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="Size" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF" />
                            <TextBlock Text="Scales the resting notch" FontSize="11" Foreground="#8E8E93" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.NotchScale, Mode=OneWay}" FontSize="12" Foreground="#8E8E93" VerticalAlignment="Center" />
                            <Slider Value="{x:Bind ViewModel.NotchScale, Mode=TwoWay}" Minimum="70" Maximum="130" Width="140" Foreground="#FFFFFF" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <!-- Resting layout -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="Resting layout" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF" />
                            <TextBlock Text="Time and battery in corners or center" FontSize="11" Foreground="#8E8E93" />
                        </StackPanel>
                        <Border Grid.Column="1" Background="#141417" BorderBrush="#222226" BorderThickness="1" CornerRadius="8" Padding="2" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <Button x:Name="BtnRestingCorners" Content="Corners" Click="OnRestingLayoutClick" Tag="0" Background="#27272A" Foreground="#FFFFFF" CornerRadius="6" Padding="14,5" FontSize="11" />
                                <Button x:Name="BtnRestingCenter" Content="Center" Click="OnRestingLayoutClick" Tag="1" Background="Transparent" Foreground="#8E8E93" CornerRadius="6" Padding="14,5" FontSize="11" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>

                <!-- ==================== SECTION 3: APPEARANCE ==================== -->
                <StackPanel Spacing="20" Visibility="{x:Bind IsSectionVisible(ViewModel.SelectedSection, 'Appearance'), Mode=OneWay}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Appearance" FontSize="26" FontWeight="Bold" Foreground="#FFFFFF" />
                        <TextBlock Text="Theme, surface and notch effects" FontSize="12" Foreground="#8E8E93" />
                    </StackPanel>

                    <!-- THEME Section -->
                    <StackPanel Spacing="10">
                        <TextBlock Text="THEME" FontSize="11" FontWeight="SemiBold" Foreground="#71717A" CharacterSpacing="50" />
                        <Grid ColumnSpacing="12" RowSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Theme 1: Pure Black (Selected) -->
                            <Border x:Name="CardThemePureBlack" Grid.Row="0" Grid.Column="0" PointerPressed="OnThemeCardClick" Tag="0" Background="#141417" BorderBrush="#FFFFFF" BorderThickness="1" CornerRadius="12" Padding="14">
                                <StackPanel Spacing="6" IsHitTestVisible="False">
                                    <TextBlock Text="Pure Black" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" />
                                    <TextBlock Text="Monochrome on true black" FontSize="11" Foreground="#8E8E93" />
                                </StackPanel>
                            </Border>

                            <!-- Theme 2: Ember Dark -->
                            <Border x:Name="CardThemeEmberDark" Grid.Row="0" Grid.Column="1" PointerPressed="OnThemeCardClick" Tag="1" Background="#141417" BorderBrush="#222226" BorderThickness="1" CornerRadius="12" Padding="14">
                                <StackPanel Spacing="6" IsHitTestVisible="False">
                                    <TextBlock Text="Ember Dark" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" />
                                    <TextBlock Text="Black with an orange accent" FontSize="11" Foreground="#8E8E93" />
                                </StackPanel>
                            </Border>

                            <!-- Theme 3: Vivid -->
                            <Border x:Name="CardThemeVivid" Grid.Row="1" Grid.Column="0" PointerPressed="OnThemeCardClick" Tag="2" Background="#141417" BorderBrush="#222226" BorderThickness="1" CornerRadius="12" Padding="14">
                                <StackPanel Spacing="6" IsHitTestVisible="False">
                                    <TextBlock Text="Vivid" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" />
                                    <TextBlock Text="Black with a blue accent" FontSize="11" Foreground="#8E8E93" />
                                </StackPanel>
                            </Border>

                            <!-- Theme 4: Silver -->
                            <Border x:Name="CardThemeSilver" Grid.Row="1" Grid.Column="1" PointerPressed="OnThemeCardClick" Tag="3" Background="#141417" BorderBrush="#222226" BorderThickness="1" CornerRadius="12" Padding="14">
                                <StackPanel Spacing="6" IsHitTestVisible="False">
                                    <TextBlock Text="Silver" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" />
                                    <TextBlock Text="Light panel; the notch stays black" FontSize="11" Foreground="#8E8E93" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <!-- SURFACE Section -->
                    <StackPanel Spacing="16">
                        <TextBlock Text="SURFACE" FontSize="11" FontWeight="SemiBold" Foreground="#71717A" CharacterSpacing="50" />

                        <!-- Outline -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="Outline" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                <TextBlock Text="A hairline around the notch" FontSize="11" Foreground="#8E8E93" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.OutlineEnabled, Mode=TwoWay}"
                                          OnContent="" OffContent="" VerticalAlignment="Center" />
                        </Grid>

                        <!-- Outline width -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Outline width" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                            <Border Grid.Column="1" Background="#141417" BorderBrush="#222226" BorderThickness="1" CornerRadius="8" Padding="2" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <Button x:Name="BtnOutline1px" Content="1 px" Click="OnOutlineWidthClick" Tag="0" Background="#27272A" Foreground="#FFFFFF" CornerRadius="6" Padding="12,5" FontSize="11" />
                                    <Button x:Name="BtnOutline2px" Content="2 px" Click="OnOutlineWidthClick" Tag="1" Background="Transparent" Foreground="#8E8E93" CornerRadius="6" Padding="12,5" FontSize="11" />
                                    <Button x:Name="BtnOutline3px" Content="3 px" Click="OnOutlineWidthClick" Tag="2" Background="Transparent" Foreground="#8E8E93" CornerRadius="6" Padding="12,5" FontSize="11" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Shadow -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="Shadow" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                <TextBlock Text="Depth under the open notch" FontSize="11" Foreground="#8E8E93" />
                            </StackPanel>
                            <Border Grid.Column="1" Background="#141417" BorderBrush="#222226" BorderThickness="1" CornerRadius="8" Padding="2" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <Button x:Name="BtnShadowNone" Content="None" Click="OnShadowClick" Tag="0" Background="Transparent" Foreground="#8E8E93" CornerRadius="6" Padding="10,5" FontSize="11" />
                                    <Button x:Name="BtnShadowSubtle" Content="Subtle" Click="OnShadowClick" Tag="1" Background="Transparent" Foreground="#8E8E93" CornerRadius="6" Padding="10,5" FontSize="11" />
                                    <Button x:Name="BtnShadowMedium" Content="Medium" Click="OnShadowClick" Tag="2" Background="#27272A" Foreground="#FFFFFF" CornerRadius="6" Padding="10,5" FontSize="11" />
                                    <Button x:Name="BtnShadowDeep" Content="Deep" Click="OnShadowClick" Tag="3" Background="Transparent" Foreground="#8E8E93" CornerRadius="6" Padding="10,5" FontSize="11" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Soft edge -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="Soft edge" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                <TextBlock Text="Softens the notch edge; unavailable in reduced-effects mode" FontSize="11" Foreground="#8E8E93" />
                            </StackPanel>
                            <Border Grid.Column="1" Background="#141417" BorderBrush="#222226" BorderThickness="1" CornerRadius="8" Padding="2" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <Button x:Name="BtnSoftEdgeNone" Content="None" Click="OnSoftEdgeClick" Tag="0" Background="Transparent" Foreground="#8E8E93" CornerRadius="6" Padding="10,5" FontSize="11" />
                                    <Button x:Name="BtnSoftEdgeLow" Content="Low" Click="OnSoftEdgeClick" Tag="1" Background="Transparent" Foreground="#8E8E93" CornerRadius="6" Padding="10,5" FontSize="11" />
                                    <Button x:Name="BtnSoftEdgeMedium" Content="Medium" Click="OnSoftEdgeClick" Tag="2" Background="#27272A" Foreground="#FFFFFF" CornerRadius="6" Padding="10,5" FontSize="11" />
                                    <Button x:Name="BtnSoftEdgeHigh" Content="High" Click="OnSoftEdgeClick" Tag="3" Background="Transparent" Foreground="#8E8E93" CornerRadius="6" Padding="10,5" FontSize="11" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </StackPanel>

                <!-- ==================== SECTION 4: MODULES ==================== -->
                <StackPanel Spacing="20" Visibility="{x:Bind IsSectionVisible(ViewModel.SelectedSection, 'Modules'), Mode=OneWay}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Modules" FontSize="26" FontWeight="Bold" Foreground="#FFFFFF" />
                        <TextBlock Text="Choose what lives in your notch. Drag to reorder." FontSize="12" Foreground="#8E8E93" />
                    </StackPanel>

                    <!-- ESSENTIALS -->
                    <StackPanel Spacing="10">
                        <TextBlock Text="ESSENTIALS" FontSize="11" FontWeight="SemiBold" Foreground="#71717A" CharacterSpacing="50" />

                        <!-- Home -->
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE80F;" FontSize="16" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Home" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                <TextBlock Text="Now playing, your next event and quick stats" FontSize="11" Foreground="#8E8E93" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="2" IsOn="True" OnContent="" OffContent="" VerticalAlignment="Center" />
                        </Grid>

                        <!-- System -->
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE950;" FontSize="16" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="System" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                <TextBlock Text="CPU, memory, disk and battery" FontSize="11" Foreground="#8E8E93" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="2" IsOn="True" OnContent="" OffContent="" VerticalAlignment="Center" />
                        </Grid>

                        <!-- Timers -->
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE916;" FontSize="16" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Timers" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                <TextBlock Text="Pomodoro, countdown, stopwatch and water" FontSize="11" Foreground="#8E8E93" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="2" IsOn="True" OnContent="" OffContent="" VerticalAlignment="Center" />
                        </Grid>

                        <!-- Weather -->
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE753;" FontSize="16" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Weather" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                <TextBlock Text="Now, hourly and five-day forecast" FontSize="11" Foreground="#8E8E93" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="2" IsOn="True" OnContent="" OffContent="" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>

                    <!-- PRODUCTIVITY -->
                    <StackPanel Spacing="10" Margin="0,10,0,0">
                        <TextBlock Text="PRODUCTIVITY" FontSize="11" FontWeight="SemiBold" Foreground="#71717A" CharacterSpacing="50" />

                        <!-- Clipboard -->
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xF0E3;" FontSize="16" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Clipboard" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                <TextBlock Text="Everything you copied, searchable" FontSize="11" Foreground="#8E8E93" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="2" IsOn="True" OnContent="" OffContent="" VerticalAlignment="Center" />
                        </Grid>

                        <!-- Notes -->
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE70F;" FontSize="16" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Notes" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                <TextBlock Text="Quick notes that stay with the notch" FontSize="11" Foreground="#8E8E93" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="2" IsOn="True" OnContent="" OffContent="" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>

                    <Button Content="Reset order" Background="#222226" Foreground="#FFFFFF" CornerRadius="6" Padding="14,6" FontSize="12" Margin="0,6,0,0" />
                </StackPanel>

                <!-- ==================== SECTION 5: LIVE ACTIVITIES ==================== -->
                <StackPanel Spacing="20" Visibility="{x:Bind IsSectionVisible(ViewModel.SelectedSection, 'Live Activities'), Mode=OneWay}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Live Activities" FontSize="26" FontWeight="Bold" Foreground="#FFFFFF" />
                        <TextBlock Text="Which events may expand the notch" FontSize="12" Foreground="#8E8E93" />
                    </StackPanel>

                    <!-- MUSIC -->
                    <StackPanel Spacing="12">
                        <TextBlock Text="MUSIC" FontSize="11" FontWeight="SemiBold" Foreground="#71717A" CharacterSpacing="50" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="Now playing" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                <TextBlock Text="Music from your player" FontSize="11" Foreground="#8E8E93" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.NowPlayingEnabled, Mode=TwoWay}" OnContent="" OffContent="" VerticalAlignment="Center" />
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="Show browser media in notch" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                <TextBlock Text="Includes videos and audio reported by your browser" FontSize="11" Foreground="#8E8E93" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.BrowserMediaEnabled, Mode=TwoWay}" OnContent="" OffContent="" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>

                    <!-- CHARGING & VOLUME -->
                    <StackPanel Spacing="12" Margin="0,8,0,0">
                        <TextBlock Text="SYSTEM FEEDBACK" FontSize="11" FontWeight="SemiBold" Foreground="#71717A" CharacterSpacing="50" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="Battery charging" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                <TextBlock Text="Plugged in, unplugged and fully charged" FontSize="11" Foreground="#8E8E93" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.BatteryChargingActivity, Mode=TwoWay}" OnContent="" OffContent="" VerticalAlignment="Center" />
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="Volume change feedback" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                <TextBlock Text="Brief notch peek when adjusting system volume" FontSize="11" Foreground="#8E8E93" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.VolumeActivity, Mode=TwoWay}" OnContent="" OffContent="" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </StackPanel>

                <!-- ==================== SECTION 6: PRIVACY ==================== -->
                <StackPanel Spacing="20" Visibility="{x:Bind IsSectionVisible(ViewModel.SelectedSection, 'Privacy'), Mode=OneWay}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Privacy" FontSize="26" FontWeight="Bold" Foreground="#FFFFFF" />
                        <TextBlock Text="Permissions and local data management" FontSize="12" Foreground="#8E8E93" />
                    </StackPanel>

                    <Border Background="#141417" BorderBrush="#222226" BorderThickness="1" CornerRadius="12" Padding="16">
                        <StackPanel Spacing="8">
                            <TextBlock Text="100% Offline &amp; Local" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" />
                            <TextBlock Text="QuickDock does not collect telemetry, send analytics, or transmit personal data. All clipboard history, notes, and metrics remain strictly on your local PC."
                                       FontSize="12" Foreground="#8E8E93" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <StackPanel Spacing="8">
                        <Button Content="Clear Clipboard History" Command="{x:Bind ViewModel.ClearClipboardDataCommand}"
                                Background="#1C1C1F" Foreground="#FFFFFF" CornerRadius="6" Padding="14,8" FontSize="12" />
                        <Button Content="Clear Screen Time Logs" Command="{x:Bind ViewModel.ClearHistoryDataCommand}"
                                Background="#1C1C1F" Foreground="#FFFFFF" CornerRadius="6" Padding="14,8" FontSize="12" />
                    </StackPanel>
                </StackPanel>

                <!-- ==================== SECTION 7: ABOUT ==================== -->
                <StackPanel Spacing="20" Visibility="{x:Bind IsSectionVisible(ViewModel.SelectedSection, 'About'), Mode=OneWay}">
                    <StackPanel Spacing="12" HorizontalAlignment="Center" Margin="0,20,0,0">
                        <controls:QuickDockIcon Width="48" Height="48" HorizontalAlignment="Center" />
                        <TextBlock Text="QuickDock" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" />
                        <TextBlock Text="The notch, reimagined for Windows." FontSize="13" Foreground="#8E8E93" HorizontalAlignment="Center" />
                        <TextBlock Text="Version 1.0.0 (x64 Release)" FontSize="12" Foreground="#71717A" HorizontalAlignment="Center" />
                        <TextBlock Text="100% Free · Fully Local · No Cloud · No Telemetry" FontSize="11" Foreground="#22C55E" HorizontalAlignment="Center" Margin="0,4,0,0" />
                        <TextBlock Text="Copyright © 2026 JOJIN JOHN. All rights reserved." FontSize="11" Foreground="#52525B" HorizontalAlignment="Center" Margin="0,16,0,0" />
                    </StackPanel>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
