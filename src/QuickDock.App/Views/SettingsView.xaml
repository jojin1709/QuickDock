<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="QuickDock.App.Views.SettingsView"
    x:Name="RootSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:QuickDock.App.Controls"
    xmlns:vm="using:QuickDock.App.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <!-- Header bar with Back button -->
            <RowDefinition Height="Auto" />
            <!-- Settings content -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="4,0,4,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Command="{x:Bind MainViewModel.OpenHomeCommand, Mode=OneWay}"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Padding="8"
                    CornerRadius="6"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE72B;" FontSize="14" />
                    <TextBlock Text="Back" FontSize="13" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <TextBlock Grid.Column="1"
                       Text="Settings &amp; Configuration"
                       FontSize="16"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Margin="12,0,0,0" />
        </Grid>

        <!-- Scrollable settings body -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,8,0">
            <StackPanel Spacing="16">

                <!-- Appearance Section -->
                <controls:QuickDockSection Title="Appearance" />
                <Border Background="{ThemeResource CardBackgroundBrush}"
                        BorderBrush="{ThemeResource TileStrokeBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource CardCornerRadius}"
                        Padding="16">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Application Theme" FontWeight="Medium" FontSize="13" />
                            <TextBlock Text="Select whether to use light, dark, or follow Windows system theme."
                                       FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <ComboBox Grid.Row="0" Grid.Column="1"
                                  SelectedIndex="{x:Bind ViewModel.SelectedThemeIndex, Mode=TwoWay}"
                                  Width="140" VerticalAlignment="Center">
                            <ComboBoxItem Content="Windows Default" />
                            <ComboBoxItem Content="Light" />
                            <ComboBoxItem Content="Dark" />
                        </ComboBox>
                    </Grid>
                </Border>

                <!-- Behavior Section -->
                <controls:QuickDockSection Title="Behavior" />
                <Border Background="{ThemeResource CardBackgroundBrush}"
                        BorderBrush="{ThemeResource TileStrokeBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource CardCornerRadius}"
                        Padding="16">
                    <StackPanel Spacing="14">
                        <!-- Global Hotkey -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Global Hotkey" FontWeight="Medium" FontSize="13" />
                                <TextBlock Text="System-wide shortcut to toggle QuickDock expand and collapse."
                                           FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <Border Grid.Column="1"
                                    Background="{ThemeResource PillBackgroundBrush}"
                                    BorderBrush="{ThemeResource TileStrokeBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10,4"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.GlobalHotkey, Mode=OneWay}"
                                           FontWeight="SemiBold" FontSize="12" />
                            </Border>
                        </Grid>

                        <Rectangle Height="1" Fill="{ThemeResource SubtleDividerBrush}" />

                        <!-- Hover Delay -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Hover Expansion Delay" FontWeight="Medium" FontSize="13" />
                                <TextBlock Text="Millisecond delay before hovering expands the idle dock."
                                           FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind FormatHoverDelay(ViewModel), Mode=OneWay}"
                                       VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12" />
                        </Grid>

                        <Rectangle Height="1" Fill="{ThemeResource SubtleDividerBrush}" />

                        <!-- Auto Hide -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Auto Collapse on Focus Loss" FontWeight="Medium" FontSize="13" />
                                <TextBlock Text="Automatically collapse dock when clicking outside or pressing Escape."
                                           FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1"
                                          IsOn="{x:Bind ViewModel.AutoHide, Mode=TwoWay}"
                                          OnContent="" OffContent=""
                                          VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Modules Enabled/Disabled -->
                <controls:QuickDockSection Title="Modules" />
                <Border Background="{ThemeResource CardBackgroundBrush}"
                        BorderBrush="{ThemeResource TileStrokeBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource CardCornerRadius}"
                        Padding="16">
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.ModuleToggles, Mode=OneWay}">
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:ModuleToggleItem">
                                <Grid Margin="0,4" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Name}" FontWeight="Medium" FontSize="13" />
                                        <TextBlock Text="{x:Bind Category}" FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1"
                                                  IsOn="{x:Bind IsEnabled, Mode=TwoWay}"
                                                  OnContent="" OffContent=""
                                                  VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </Border>

                <!-- About QuickDock -->
                <controls:QuickDockSection Title="About QuickDock" />
                <Border Background="{ThemeResource CardBackgroundBrush}"
                        BorderBrush="{ThemeResource TileStrokeBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource CardCornerRadius}"
                        Padding="16">
                    <StackPanel Spacing="10">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <controls:QuickDockIcon Grid.Column="0" Width="36" Height="36"
                                                    GlyphBrush="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                    VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="QuickDock" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Text="Lightweight native Windows utility dock"
                                           FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>

                        <Rectangle Height="1" Fill="{ThemeResource SubtleDividerBrush}" />

                        <Grid RowSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Version:" FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.AppVersion, Mode=OneWay}"
                                       FontSize="11" FontWeight="Medium" Margin="8,0,0,0" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text=".NET Core:" FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.DotNetVersion, Mode=OneWay}"
                                       FontSize="11" FontWeight="Medium" Margin="8,0,0,0" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Configuration:" FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.StoragePath, Mode=OneWay}"
                                       FontSize="11" TextTrimming="CharacterEllipsis" Margin="8,0,0,0" />
                        </Grid>

                        <Button Command="{x:Bind ViewModel.ResetSettingsCommand, Mode=OneWay}"
                                Content="Reset Settings to Defaults"
                                Margin="0,6,0,0"
                                HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>

