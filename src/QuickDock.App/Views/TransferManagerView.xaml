<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="QuickDock.App.Views.TransferManagerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:QuickDock.Core.Models"
    xmlns:vm="using:QuickDock.App.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid RowSpacing="10">
        <Grid.RowDefinitions>
            <!-- Header bar with Back button -->
            <RowDefinition Height="Auto" />
            <!-- Active Transfers -->
            <RowDefinition Height="Auto" />
            <!-- History Header -->
            <RowDefinition Height="Auto" />
            <!-- Transfer History List -->
            <RowDefinition Height="*" />
            <!-- Status footer -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="4,0,4,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Command="{x:Bind MainViewModel.OpenHomeCommand, Mode=OneWay}"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Padding="8"
                    CornerRadius="6"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE72B;" FontSize="14" />
                    <TextBlock Text="Back" FontSize="13" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <TextBlock Grid.Column="1"
                       Text="Transfer Manager"
                       FontSize="16"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Margin="12,0,0,0" />

            <Button Grid.Column="2"
                    Content="Clear History"
                    Command="{x:Bind ViewModel.ClearHistoryCommand, Mode=OneWay}"
                    FontSize="11" Padding="8,4" CornerRadius="4" />
        </Grid>

        <!-- Active Transfers Section -->
        <Border Grid.Row="1"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12">
            <StackPanel Spacing="8">
                <TextBlock Text="Active Transfers" FontWeight="SemiBold" FontSize="13" />

                <ListView ItemsSource="{x:Bind ViewModel.ActiveTransfers, Mode=OneWay}"
                          SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:TransferItem">
                            <Grid Padding="4,6" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Spacing="3">
                                    <Grid>
                                        <TextBlock Text="{x:Bind FileName}" FontWeight="Medium" FontSize="12" />
                                        <TextBlock Text="{x:Bind FormattedProgress}" HorizontalAlignment="Right" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    </Grid>
                                    <ProgressBar Value="{x:Bind ProgressPercentage, Mode=OneTime}" Maximum="100" Height="4" CornerRadius="2" />
                                    <Grid>
                                        <TextBlock Text="{x:Bind FormattedSpeed}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind FormattedTransferred}" HorizontalAlignment="Right" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Grid>
                                </StackPanel>

                                <Button Grid.Column="1"
                                        Click="OnCancelTransferClicked"
                                        ToolTipService.ToolTip="Cancel Transfer"
                                        Background="Transparent" BorderBrush="Transparent" Padding="4">
                                    <FontIcon Glyph="&#xE711;" FontSize="12" Foreground="#E06C75" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </Border>

        <!-- History Header -->
        <TextBlock Grid.Row="2" Text="Transfer History" FontWeight="SemiBold" FontSize="13" Margin="4,4,0,0" />

        <!-- Transfer History List -->
        <ListView Grid.Row="3"
                  ItemsSource="{x:Bind ViewModel.TransferHistory, Mode=OneWay}"
                  SelectionMode="None"
                  CornerRadius="8"
                  Background="{ThemeResource LayerFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                  BorderThickness="1"
                  Padding="4">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:TransferItem">
                    <Grid Padding="8,6" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Icon -->
                        <Border Grid.Column="0"
                                Width="28" Height="28"
                                CornerRadius="4"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                            <FontIcon Glyph="&#xE896;" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <!-- Name and Meta -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="{x:Bind FileName}" FontWeight="Medium" FontSize="12" TextTrimming="CharacterEllipsis" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{x:Bind FormattedSize}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="•" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                <TextBlock Text="{x:Bind Status}" FontSize="10" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- SHA-256 Hash badge -->
                        <Border Grid.Column="2"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                Padding="6,2"
                                CornerRadius="4"
                                VerticalAlignment="Center">
                            <TextBlock Text="Verified SHA-256" FontSize="9" Foreground="#4EC9B0" />
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Status Footer -->
        <TextBlock Grid.Row="4"
                   Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                   FontSize="11"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Margin="4,0" />
    </Grid>
</UserControl>
