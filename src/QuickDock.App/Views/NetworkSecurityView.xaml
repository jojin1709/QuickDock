<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="QuickDock.App.Views.NetworkSecurityView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:QuickDock.Core.Models"
    xmlns:vm="using:QuickDock.App.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid RowSpacing="10">
        <Grid.RowDefinitions>
            <!-- Header bar with Back button and Navigation Pills -->
            <RowDefinition Height="Auto" />
            <!-- Section Content -->
            <RowDefinition Height="*" />
            <!-- Status Footer -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="4,0,4,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Back to Home -->
            <Button Grid.Column="0"
                    Command="{x:Bind MainViewModel.OpenHomeCommand, Mode=OneWay}"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Padding="8"
                    CornerRadius="6"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE72B;" FontSize="14" />
                    <TextBlock Text="Back" FontSize="13" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <TextBlock Grid.Column="1"
                       Text="Network &amp; Security"
                       FontSize="16"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Margin="12,0,16,0" />

            <!-- Navigation Bar for Network & Security Sections -->
            <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button Content="Overview" Click="OnNavOverviewClicked" Padding="10,4" CornerRadius="4" FontSize="12"
                            Background="{x:Bind GetNavBackground(ViewModel.SelectedSection, 'Overview'), Mode=OneWay}"
                            BorderBrush="{x:Bind GetNavBorder(ViewModel.SelectedSection, 'Overview'), Mode=OneWay}" />
                    <Button Content="Adapters" Click="OnNavAdaptersClicked" Padding="10,4" CornerRadius="4" FontSize="12"
                            Background="{x:Bind GetNavBackground(ViewModel.SelectedSection, 'Adapters'), Mode=OneWay}"
                            BorderBrush="{x:Bind GetNavBorder(ViewModel.SelectedSection, 'Adapters'), Mode=OneWay}" />
                    <Button Content="DNS &amp; Ping" Click="OnNavDnsPingClicked" Padding="10,4" CornerRadius="4" FontSize="12"
                            Background="{x:Bind GetNavBackground(ViewModel.SelectedSection, 'DnsPing'), Mode=OneWay}"
                            BorderBrush="{x:Bind GetNavBorder(ViewModel.SelectedSection, 'DnsPing'), Mode=OneWay}" />
                    <Button Content="Connections" Click="OnNavConnectionsClicked" Padding="10,4" CornerRadius="4" FontSize="12"
                            Background="{x:Bind GetNavBackground(ViewModel.SelectedSection, 'Connections'), Mode=OneWay}"
                            BorderBrush="{x:Bind GetNavBorder(ViewModel.SelectedSection, 'Connections'), Mode=OneWay}" />
                    <Button Content="TLS Inspector" Click="OnNavTlsClicked" Padding="10,4" CornerRadius="4" FontSize="12"
                            Background="{x:Bind GetNavBackground(ViewModel.SelectedSection, 'Tls'), Mode=OneWay}"
                            BorderBrush="{x:Bind GetNavBorder(ViewModel.SelectedSection, 'Tls'), Mode=OneWay}" />
                    <Button Content="Headers Audit" Click="OnNavHeadersClicked" Padding="10,4" CornerRadius="4" FontSize="12"
                            Background="{x:Bind GetNavBackground(ViewModel.SelectedSection, 'Headers'), Mode=OneWay}"
                            BorderBrush="{x:Bind GetNavBorder(ViewModel.SelectedSection, 'Headers'), Mode=OneWay}" />
                    <Button Content="Firewall &amp; AV" Click="OnNavFirewallClicked" Padding="10,4" CornerRadius="4" FontSize="12"
                            Background="{x:Bind GetNavBackground(ViewModel.SelectedSection, 'Firewall'), Mode=OneWay}"
                            BorderBrush="{x:Bind GetNavBorder(ViewModel.SelectedSection, 'Firewall'), Mode=OneWay}" />
                    <Button Content="Security Posture" Click="OnNavPostureClicked" Padding="10,4" CornerRadius="4" FontSize="12"
                            Background="{x:Bind GetNavBackground(ViewModel.SelectedSection, 'Posture'), Mode=OneWay}"
                            BorderBrush="{x:Bind GetNavBorder(ViewModel.SelectedSection, 'Posture'), Mode=OneWay}" />
                    <Button Content="File Integrity" Click="OnNavIntegrityClicked" Padding="10,4" CornerRadius="4" FontSize="12"
                            Background="{x:Bind GetNavBackground(ViewModel.SelectedSection, 'Integrity'), Mode=OneWay}"
                            BorderBrush="{x:Bind GetNavBorder(ViewModel.SelectedSection, 'Integrity'), Mode=OneWay}" />
                    <Button Content="Report" Click="OnNavReportClicked" Padding="10,4" CornerRadius="4" FontSize="12"
                            Background="{x:Bind GetNavBackground(ViewModel.SelectedSection, 'Report'), Mode=OneWay}"
                            BorderBrush="{x:Bind GetNavBorder(ViewModel.SelectedSection, 'Report'), Mode=OneWay}" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ==================== MAIN CONTENT AREA ==================== -->
        <Grid Grid.Row="1">

            <!-- 1. OVERVIEW SECTION -->
            <Grid Visibility="{x:Bind GetSectionVisibility(ViewModel.SelectedSection, 'Overview'), Mode=OneWay}" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Local Network Status &amp; Active Interface" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="Lookup Public IP" Command="{x:Bind ViewModel.LookupPublicIpCommand, Mode=OneWay}" Margin="0,0,8,0" FontSize="12" Padding="8,4" />
                    <Button Grid.Column="2" Content="Refresh" Command="{x:Bind ViewModel.RefreshOverviewCommand, Mode=OneWay}" FontSize="12" Padding="8,4" />
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="10">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                            <Grid RowSpacing="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Primary Adapter:" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.Overview.PrimaryInterfaceName, Mode=OneWay, FallbackValue='Detecting...'}" FontWeight="SemiBold" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Connection Type:" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.Overview.ConnectionType, Mode=OneWay, FallbackValue='Unknown'}" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Status:" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.Overview.OperationalStatus, Mode=OneWay, FallbackValue='Unknown'}" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Public IP:" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind ViewModel.PublicIpText, Mode=OneWay}" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            </Grid>
                        </Border>

                        <TextBlock Text="Local Interfaces Summary" FontSize="13" FontWeight="SemiBold" Margin="0,4,0,0" />
                        <ListView ItemsSource="{x:Bind ViewModel.Adapters, Mode=OneWay}" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:NetworkAdapterDetail">
                                    <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="10,8" Margin="0,2">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Spacing="2">
                                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="12" />
                                                <TextBlock Text="{x:Bind Description}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind SpeedFormatted}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                            <Border Grid.Column="1" Background="{ThemeResource SystemFillColorSolidAttentionBackgroundBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Status}" FontSize="11" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- 2. ADAPTERS SECTION -->
            <Grid Visibility="{x:Bind GetSectionVisibility(ViewModel.SelectedSection, 'Adapters'), Mode=OneWay}" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Network Interface Details" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="Refresh Adapters" Command="{x:Bind ViewModel.RefreshAdaptersCommand, Mode=OneWay}" FontSize="12" Padding="8,4" />
                </Grid>
                <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Adapters, Mode=OneWay}" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:NetworkAdapterDetail">
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,4">
                                <StackPanel Spacing="6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="13" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind SpeedFormatted}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Grid>
                                    <TextBlock Text="{x:Bind Description}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Type:" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind InterfaceType}" FontSize="11" />
                                        <TextBlock Grid.Column="2" Text="MAC:" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Grid.Column="3" Text="{x:Bind MacAddress}" FontSize="11" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!-- 3. DNS & PING SECTION -->
            <Grid Visibility="{x:Bind GetSectionVisibility(ViewModel.SelectedSection, 'DnsPing'), Mode=OneWay}" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{x:Bind ViewModel.DnsDomain, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="DNS Host (e.g. google.com)" FontSize="12" />
                    <Button Grid.Column="1" Content="Query DNS" Command="{x:Bind ViewModel.ExecuteDnsQueryCommand, Mode=OneWay}" FontSize="12" Padding="10,4" />
                    <TextBox Grid.Column="2" Text="{x:Bind ViewModel.PingTarget, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Ping Host/IP (e.g. 1.1.1.1)" FontSize="12" />
                    <Button Grid.Column="3" Content="Ping Host" Command="{x:Bind ViewModel.ExecutePingCommand, Mode=OneWay}" FontSize="12" Padding="10,4" />
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="10">
                        <!-- Ping Summary Card -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Ping Connectivity Diagnostic" FontWeight="SemiBold" FontSize="12" />
                                <TextBlock Text="{x:Bind ViewModel.PingResult.SummaryText, Mode=OneWay, FallbackValue='Enter a target and click Ping Host.'}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind ViewModel.GatewayConnectivityStatus, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- DNS Records List -->
                        <TextBlock Text="DNS Query Results" FontSize="13" FontWeight="SemiBold" />
                        <ListView ItemsSource="{x:Bind ViewModel.DnsResult.Records, Mode=OneWay}" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:DnsRecordItem">
                                    <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="10,6" Margin="0,2">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="60" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{x:Bind RecordType}" FontWeight="SemiBold" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind Value}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="2" Text="{x:Bind Ttl}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- 4. CONNECTIONS & LISTENING PORTS SECTION -->
            <Grid Visibility="{x:Bind GetSectionVisibility(ViewModel.SelectedSection, 'Connections'), Mode=OneWay}" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{x:Bind ViewModel.ConnectionSearchFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Filter by port, address, state, or process name..." FontSize="12" />
                    <Button Grid.Column="1" Content="Refresh Sockets" Command="{x:Bind ViewModel.RefreshConnectionsCommand, Mode=OneWay}" FontSize="12" Padding="8,4" />
                </Grid>

                <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.FilteredConnections, Mode=OneWay}" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:ActiveConnectionInfo">
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,2">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="50" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Bind Protocol}" FontWeight="SemiBold" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind LocalEndpoint}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind RemoteEndpoint}" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind State}" FontSize="11" />
                                    <TextBlock Grid.Column="4" Text="{x:Bind ProcessName}" FontSize="11" TextTrimming="CharacterEllipsis" HorizontalAlignment="Right" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!-- 5. TLS INSPECTOR SECTION -->
            <Grid Visibility="{x:Bind GetSectionVisibility(ViewModel.SelectedSection, 'Tls'), Mode=OneWay}" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{x:Bind ViewModel.TlsHost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Host (e.g. google.com, github.com)" FontSize="12" />
                    <TextBox Grid.Column="1" Text="{x:Bind ViewModel.TlsPort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Port" FontSize="12" />
                    <Button Grid.Column="2" Content="Inspect Certificate" Command="{x:Bind ViewModel.InspectTlsCommand, Mode=OneWay}" FontSize="12" Padding="10,4" />
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{x:Bind ViewModel.TlsResult.TargetHost, Mode=OneWay, FallbackValue='No certificate inspected yet'}" FontSize="13" FontWeight="SemiBold" />
                            <Grid RowSpacing="6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Protocol:" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.TlsResult.NegotiatedProtocol, Mode=OneWay, FallbackValue='-'}" FontSize="11" FontWeight="SemiBold" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Cipher Suite:" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.TlsResult.CipherSuite, Mode=OneWay, FallbackValue='-'}" FontSize="11" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Valid Until:" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.TlsResult.ValidUntil, Mode=OneWay, FallbackValue='-'}" FontSize="11" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Days Remaining:" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind ViewModel.TlsResult.DaysRemaining, Mode=OneWay, FallbackValue=0}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Subject:" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{x:Bind ViewModel.TlsResult.Subject, Mode=OneWay, FallbackValue='-'}" FontSize="11" TextWrapping="Wrap" />

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Issuer:" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="{x:Bind ViewModel.TlsResult.Issuer, Mode=OneWay, FallbackValue='-'}" FontSize="11" TextWrapping="Wrap" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </Grid>

            <!-- 6. HTTP HEADERS AUDIT SECTION -->
            <Grid Visibility="{x:Bind GetSectionVisibility(ViewModel.SelectedSection, 'Headers'), Mode=OneWay}" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{x:Bind ViewModel.HttpInspectUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="URL (e.g. https://github.com)" FontSize="12" />
                    <Button Grid.Column="1" Content="Analyze Headers" Command="{x:Bind ViewModel.InspectHeadersCommand, Mode=OneWay}" FontSize="12" Padding="10,4" />
                </Grid>

                <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.HeadersResult.HeaderChecks, Mode=OneWay}" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:HeaderCheckItem">
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,2">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="{x:Bind HeaderName}" FontWeight="SemiBold" FontSize="11" />
                                        <TextBlock Text="{x:Bind Value}" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{x:Bind Assessment}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind Recommendation}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!-- 7. FIREWALL & DEFENDER SECTION -->
            <Grid Visibility="{x:Bind GetSectionVisibility(ViewModel.SelectedSection, 'Firewall'), Mode=OneWay}" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Windows Defender &amp; Native Firewall Status" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="Refresh Status" Command="{x:Bind ViewModel.RefreshFirewallCommand, Mode=OneWay}" FontSize="12" Padding="8,4" />
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="10">
                        <!-- Defender Card -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Microsoft Defender Antivirus" FontSize="13" FontWeight="SemiBold" />
                                <Grid RowSpacing="6">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Product:" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.WindowsSecurity.AntivirusProductName, Mode=OneWay, FallbackValue='Windows Defender'}" FontSize="11" FontWeight="SemiBold" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Details:" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.WindowsSecurity.StatusDetails, Mode=OneWay, FallbackValue='Active and protecting system'}" FontSize="11" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Firewall Profiles -->
                        <TextBlock Text="Firewall Profiles" FontSize="13" FontWeight="SemiBold" />
                        <ListView ItemsSource="{x:Bind ViewModel.FirewallStatus.Profiles, Mode=OneWay}" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:FirewallProfileStatus">
                                    <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="12,8" Margin="0,2">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{x:Bind ProfileName}" FontWeight="SemiBold" FontSize="12" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind IsEnabled}" FontSize="11" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{x:Bind InboundAction}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- 8. SECURITY POSTURE CHECKS SECTION -->
            <Grid Visibility="{x:Bind GetSectionVisibility(ViewModel.SelectedSection, 'Posture'), Mode=OneWay}" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Defensive Posture &amp; Configuration Diagnostics" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="Run Audit Checks" Command="{x:Bind ViewModel.RunSecurityChecksCommand, Mode=OneWay}" FontSize="12" Padding="8,4" />
                </Grid>

                <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.SecurityChecksResult.Findings, Mode=OneWay}" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:SecurityFinding">
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,2">
                                <StackPanel Spacing="4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Bind Title}" FontWeight="SemiBold" FontSize="12" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind Severity}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    </Grid>
                                    <TextBlock Text="{x:Bind Description}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind Recommendation}" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!-- 9. FILE INTEGRITY SECTION -->
            <Grid Visibility="{x:Bind GetSectionVisibility(ViewModel.SelectedSection, 'Integrity'), Mode=OneWay}" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{x:Bind ViewModel.IntegrityFilePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Full file path to verify..." FontSize="12" />
                    <Button Grid.Column="1" Content="Compute &amp; Verify" Command="{x:Bind ViewModel.VerifyIntegrityCommand, Mode=OneWay}" FontSize="12" Padding="10,4" />
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Calculated Hash:" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBox Text="{x:Bind ViewModel.IntegrityResult.ComputedHash, Mode=OneWay, FallbackValue=''}" IsReadOnly="True" FontSize="11" FontFamily="Consolas" TextWrapping="Wrap" />

                            <TextBlock Text="Expected Hash (Optional verification):" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
                            <TextBox Text="{x:Bind ViewModel.IntegrityExpectedHash, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Paste expected checksum here to verify match..." FontSize="11" FontFamily="Consolas" />

                            <TextBlock Text="{x:Bind ViewModel.IntegrityResult.IsMatch, Mode=OneWay, FallbackValue=false}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </Grid>

            <!-- 10. SECURITY REPORT SECTION -->
            <Grid Visibility="{x:Bind GetSectionVisibility(ViewModel.SelectedSection, 'Report'), Mode=OneWay}" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Export Comprehensive Defensive Diagnostics" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="Generate Report" Command="{x:Bind ViewModel.GenerateReportCommand, Mode=OneWay}" FontSize="12" Padding="8,4" />
                    <Button Grid.Column="2" Content="Copy to Clipboard" Command="{x:Bind ViewModel.CopyReportCommand, Mode=OneWay}" FontSize="12" Padding="8,4" />
                </Grid>

                <TextBox Grid.Row="1"
                         Text="{x:Bind ViewModel.ReportContent, Mode=OneWay}"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         FontFamily="Consolas"
                         FontSize="11"
                         TextWrapping="Wrap" />
            </Grid>

        </Grid>

        <!-- ==================== STATUS FOOTER ==================== -->
        <Border Grid.Row="2" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="4" Padding="8,4" Margin="4,0,4,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.ReportStatusMessage, Mode=OneWay, FallbackValue='Defensive diagnostics ready.'}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                <ProgressRing Grid.Column="1" IsActive="{x:Bind ViewModel.IsOverviewBusy, Mode=OneWay}" Width="14" Height="14" Margin="8,0,0,0" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
