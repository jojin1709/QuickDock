<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="QuickDock.App.Views.HomeView"
    x:Name="RootHomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:QuickDock.App.Controls"
    xmlns:vm="using:QuickDock.App.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Margin="16,8,16,10" RowSpacing="12" ColumnSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ==================== CARD 1: SCREEN TIME ==================== -->
        <Border Grid.Row="0" Grid.Column="0"
                Background="#18181B"
                BorderBrush="#27272A"
                BorderThickness="1"
                CornerRadius="16"
                Padding="16,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE9D9;" FontSize="11" Foreground="#A1A1AA" />
                    <TextBlock Text="SCREEN TIME"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="#A1A1AA"
                               CharacterSpacing="60"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Body -->
                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Large Text & Subtitle -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind ViewModel.ScreenTimeBigText, Mode=OneWay}"
                                   FontSize="32"
                                   FontWeight="Bold"
                                   Foreground="#FFFFFF" />
                        <TextBlock Text="{x:Bind ViewModel.ScreenTimeSubtitleText, Mode=OneWay}"
                                   FontSize="12"
                                   Foreground="#71717A"
                                   Margin="0,4,0,0" />
                    </StackPanel>

                    <!-- Mini Vertical Sparkline Bar Chart -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="4"
                                VerticalAlignment="Bottom"
                                Margin="0,0,2,4">
                        <Border Width="5" Height="10" CornerRadius="2.5" Background="#2E2E33" VerticalAlignment="Bottom" />
                        <Border Width="5" Height="16" CornerRadius="2.5" Background="#2E2E33" VerticalAlignment="Bottom" />
                        <Border Width="5" Height="8"  CornerRadius="2.5" Background="#2E2E33" VerticalAlignment="Bottom" />
                        <Border Width="5" Height="24" CornerRadius="2.5" Background="#2E2E33" VerticalAlignment="Bottom" />
                        <Border Width="5" Height="14" CornerRadius="2.5" Background="#2E2E33" VerticalAlignment="Bottom" />
                        <Border Width="5" Height="36" CornerRadius="2.5" Background="#FFFFFF" VerticalAlignment="Bottom" />
                        <Border Width="5" Height="12" CornerRadius="2.5" Background="#2E2E33" VerticalAlignment="Bottom" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ==================== CARD 2: SYSTEM (3 Radial Rings) ==================== -->
        <Border Grid.Row="0" Grid.Column="1"
                Background="#18181B"
                BorderBrush="#27272A"
                BorderThickness="1"
                CornerRadius="16"
                Padding="16,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE770;" FontSize="11" Foreground="#A1A1AA" />
                    <TextBlock Text="SYSTEM"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="#A1A1AA"
                               CharacterSpacing="60"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- 3 Circular Rings -->
                <Grid Grid.Row="1" Margin="0,8,0,0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Ring 1: CPU -->
                    <StackPanel Grid.Column="0" HorizontalAlignment="Center" Spacing="4">
                        <Grid Width="46" Height="46">
                            <Ellipse Width="46" Height="46" Stroke="#27272A" StrokeThickness="3.5" />
                            <Ellipse Width="46" Height="46" Stroke="#3B82F6" StrokeThickness="3.5" StrokeDashArray="3 1" />
                            <TextBlock Text="{x:Bind ViewModel.CpuPercentText, Mode=OneWay}"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="#FFFFFF"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Text="CPU"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="#71717A"
                                   HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- Ring 2: RAM -->
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center" Spacing="4">
                        <Grid Width="46" Height="46">
                            <Ellipse Width="46" Height="46" Stroke="#27272A" StrokeThickness="3.5" />
                            <Ellipse Width="46" Height="46" Stroke="#10B981" StrokeThickness="3.5" StrokeDashArray="3.5 1" />
                            <TextBlock Text="{x:Bind ViewModel.RamPercentText, Mode=OneWay}"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="#FFFFFF"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Text="RAM"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="#71717A"
                                   HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- Ring 3: DISK -->
                    <StackPanel Grid.Column="2" HorizontalAlignment="Center" Spacing="4">
                        <Grid Width="46" Height="46">
                            <Ellipse Width="46" Height="46" Stroke="#27272A" StrokeThickness="3.5" />
                            <Ellipse Width="46" Height="46" Stroke="#8B5CF6" StrokeThickness="3.5" StrokeDashArray="1 2" />
                            <TextBlock Text="{x:Bind ViewModel.DiskPercentText, Mode=OneWay}"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="#FFFFFF"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Text="DISK"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="#71717A"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ==================== CARD 3: WEATHER ==================== -->
        <Border Grid.Row="0" Grid.Column="2"
                Background="#18181B"
                BorderBrush="#27272A"
                BorderThickness="1"
                CornerRadius="16"
                Padding="16,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE753;" FontSize="11" Foreground="#A1A1AA" />
                    <TextBlock Text="WEATHER"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="#A1A1AA"
                               CharacterSpacing="60"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Body -->
                <Grid Grid.Row="1" Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Large Temp -->
                        <TextBlock Grid.Column="0"
                                   Text="{x:Bind ViewModel.WeatherTempText, Mode=OneWay}"
                                   FontSize="34"
                                   FontWeight="Bold"
                                   Foreground="#FFFFFF"
                                   VerticalAlignment="Center" />

                        <!-- Weather Sun/Cloud Glyph -->
                        <FontIcon Grid.Column="1"
                                  Glyph="&#xE753;"
                                  FontSize="30"
                                  Foreground="#FBBF24"
                                  VerticalAlignment="Center"
                                  Margin="0,0,4,0" />
                    </Grid>

                    <!-- Subtitle & High/Low -->
                    <StackPanel Grid.Row="1" VerticalAlignment="Bottom">
                        <TextBlock Text="{x:Bind ViewModel.WeatherConditionText, Mode=OneWay}"
                                   FontSize="12"
                                   Foreground="#D4D4D8"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind ViewModel.WeatherHighLowText, Mode=OneWay}"
                                   FontSize="11"
                                   Foreground="#71717A"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ==================== CARD 4: FOCUS (Pomodoro Timer) ==================== -->
        <Border Grid.Row="1" Grid.Column="0"
                Background="#18181B"
                BorderBrush="#27272A"
                BorderThickness="1"
                CornerRadius="16"
                Padding="16,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE916;" FontSize="11" Foreground="#A1A1AA" />
                    <TextBlock Text="FOCUS"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="#A1A1AA"
                               CharacterSpacing="60"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Body -->
                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Countdown & Subtitle -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind ViewModel.FocusTimerText, Mode=OneWay}"
                                   FontSize="32"
                                   FontWeight="Bold"
                                   Foreground="#FFFFFF" />
                        <TextBlock Text="{x:Bind ViewModel.FocusTimerSubtitleText, Mode=OneWay}"
                                   FontSize="12"
                                   Foreground="#71717A"
                                   Margin="0,4,0,0" />
                    </StackPanel>

                    <!-- Circular Play/Pause Action Button -->
                    <Button Grid.Column="1"
                            Command="{x:Bind ViewModel.ToggleFocusTimerCommand}"
                            Background="#FFFFFF"
                            BorderBrush="Transparent"
                            Width="44" Height="44"
                            CornerRadius="22"
                            Padding="0"
                            VerticalAlignment="Center">
                        <FontIcon Glyph="{x:Bind ViewModel.FocusPlayGlyph, Mode=OneWay}"
                                  FontSize="16"
                                  Foreground="#000000"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                    </Button>
                </Grid>
            </Grid>
        </Border>

        <!-- ==================== CARD 5: CLIPBOARD ==================== -->
        <Border Grid.Row="1" Grid.Column="1"
                Background="#18181B"
                BorderBrush="#27272A"
                BorderThickness="1"
                CornerRadius="16"
                Padding="16,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xF0E3;" FontSize="11" Foreground="#A1A1AA" />
                    <TextBlock Text="CLIPBOARD"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="#A1A1AA"
                               CharacterSpacing="60"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- 2 Recent Items -->
                <ItemsControl Grid.Row="1"
                              ItemsSource="{x:Bind ViewModel.RecentClips, Mode=OneWay}"
                              Margin="0,8,0,0"
                              VerticalAlignment="Center">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:RecentClipDisplayItem">
                            <Border Background="#202024"
                                    BorderBrush="#2A2A2E"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="8,6"
                                    Margin="0,0,0,6">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Thumbnail Glyph -->
                                    <Border Grid.Column="0"
                                            Width="22" Height="22"
                                            Background="#2A2A2E"
                                            CornerRadius="4">
                                        <FontIcon Glyph="{x:Bind IconGlyph}"
                                                  FontSize="11"
                                                  Foreground="#A1A1AA"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                    </Border>

                                    <!-- Title/Dimensions -->
                                    <TextBlock Grid.Column="1"
                                               Text="{x:Bind Title}"
                                               FontSize="11"
                                               Foreground="#E4E4E7"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />

                                    <!-- Time Ago -->
                                    <TextBlock Grid.Column="2"
                                               Text="{x:Bind TimeAgo}"
                                               FontSize="10"
                                               Foreground="#71717A"
                                               VerticalAlignment="Center" />

                                    <!-- Copy Action -->
                                    <Button Grid.Column="3"
                                            Click="OnCopyClipClick"
                                            Tag="{x:Bind Content}"
                                            Background="Transparent"
                                            BorderBrush="Transparent"
                                            Padding="4"
                                            CornerRadius="4"
                                            VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE8C8;" FontSize="11" Foreground="#A1A1AA" />
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>

        <!-- ==================== CARD 6: NOTES ==================== -->
        <Border Grid.Row="1" Grid.Column="2"
                Background="#18181B"
                BorderBrush="#27272A"
                BorderThickness="1"
                CornerRadius="16"
                Padding="16,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE70B;" FontSize="11" Foreground="#A1A1AA" />
                    <TextBlock Text="NOTES"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="#A1A1AA"
                               CharacterSpacing="60"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Body -->
                <Grid Grid.Row="1" Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Latest note or "No notes yet" -->
                    <TextBlock Grid.Row="0"
                               Text="{x:Bind ViewModel.NotesSubtitleText, Mode=OneWay}"
                               FontSize="12"
                               Foreground="#71717A"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />

                    <!-- Quick Note Pill Input Box -->
                    <Border Grid.Row="1"
                            Background="#222226"
                            BorderBrush="#2E2E33"
                            BorderThickness="1"
                            CornerRadius="16"
                            Height="34"
                            Padding="10,0,4,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0"
                                     PlaceholderText="Write a note..."
                                     Text="{x:Bind ViewModel.NewNoteText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     FontSize="12"
                                     Foreground="#FFFFFF"
                                     KeyDown="OnNewNoteKeyDown"
                                     VerticalAlignment="Center"
                                     Padding="0" />

                            <Button Grid.Column="1"
                                    Command="{x:Bind ViewModel.AddQuickNoteCommand}"
                                    Background="#FFFFFF"
                                    BorderBrush="Transparent"
                                    Width="26" Height="26"
                                    CornerRadius="13"
                                    Padding="0"
                                    VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE710;" FontSize="11" Foreground="#000000" />
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>

    </Grid>
</UserControl>
