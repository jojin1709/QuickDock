<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="QuickDock.App.Views.HomeView"
    x:Name="RootHomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:QuickDock.App.Controls"
    xmlns:vm="using:QuickDock.App.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <!-- Header bar with clock, search, metrics, settings -->
            <RowDefinition Height="Auto" />
            <!-- Scrollable modules section -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Header Controls -->
        <Grid Grid.Row="0" ColumnSpacing="12" Margin="4,0,4,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Time & Date -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="{x:Bind ViewModel.CurrentTime, Mode=OneWay}"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                <TextBlock Text="{x:Bind ViewModel.CurrentDate, Mode=OneWay}"
                           FontSize="11"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- Search Filter -->
            <TextBox Grid.Column="1"
                     PlaceholderText="Search modules..."
                     Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     VerticalAlignment="Center"
                     MaxWidth="260"
                     CornerRadius="{StaticResource SearchBoxCornerRadius}">
            </TextBox>

            <!-- Real System Metrics Status Bar -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <controls:QuickDockStatusPill Text="{x:Bind ViewModel.CpuMetricText, Mode=OneWay}"
                                              DotBrush="{ThemeResource StatusAccentBrush}" />
                <controls:QuickDockStatusPill Text="{x:Bind ViewModel.MemoryMetricText, Mode=OneWay}"
                                              DotBrush="{ThemeResource StatusAccentBrush}" />
                <controls:QuickDockStatusPill Text="{x:Bind ViewModel.BatteryMetricText, Mode=OneWay}"
                                              DotBrush="{ThemeResource StatusActiveBrush}" />
                <controls:QuickDockStatusPill Text="{x:Bind ViewModel.VolumeMetricText, Mode=OneWay}"
                                              DotBrush="{ThemeResource StatusInactiveBrush}" />
            </StackPanel>

            <!-- Settings Button -->
            <Button Grid.Column="3"
                    ToolTipService.ToolTip="Settings"
                    Command="{x:Bind MainViewModel.OpenSettingsCommand, Mode=OneWay}"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Padding="8"
                    CornerRadius="6"
                    VerticalAlignment="Center">
                <FontIcon Glyph="&#xE713;" FontSize="16" />
            </Button>
        </Grid>

        <!-- Module Catalog Scroll Area -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,8,0">
            <StackPanel Spacing="14">

                <!-- Temporary Message Banner -->
                <Border Visibility="{x:Bind GetBoolVisibility(ViewModel.HasTemporaryMessage), Mode=OneWay}"
                        Background="{ThemeResource CardBackgroundBrush}"
                        BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12,8">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE783;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.TemporaryMessageText, Mode=OneWay}" FontSize="12" FontWeight="Medium" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <Button Grid.Column="2" Command="{x:Bind ViewModel.DismissTemporaryMessageCommand}" Background="Transparent" BorderBrush="Transparent" Padding="4">
                            <FontIcon Glyph="&#xE711;" FontSize="11" />
                        </Button>
                    </Grid>
                </Border>

                <!-- Productivity Summaries Strip -->
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Padding="8,6" Background="{ThemeResource CardBackgroundBrush}" BorderBrush="{ThemeResource TileStrokeBrush}" BorderThickness="1" CornerRadius="6">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xF0E3;" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.ClipboardSnippetText, Mode=OneWay}" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Padding="8,6" Background="{ThemeResource CardBackgroundBrush}" BorderBrush="{ThemeResource TileStrokeBrush}" BorderThickness="1" CornerRadius="6">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE916;" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.ActiveTimerText, Mode=OneWay}" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Padding="8,6" Background="{ThemeResource CardBackgroundBrush}" BorderBrush="{ThemeResource TileStrokeBrush}" BorderThickness="1" CornerRadius="6">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE753;" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.WeatherSnippetText, Mode=OneWay}" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="3" Padding="8,6" Background="{ThemeResource CardBackgroundBrush}" BorderBrush="{ThemeResource TileStrokeBrush}" BorderThickness="1" CornerRadius="6">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xEC58;" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.ScreenTimeSnippetText, Mode=OneWay}" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Quick Controls: Volume & Media -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Volume Card -->
                    <Border Grid.Column="0"
                            Background="{ThemeResource CardBackgroundBrush}"
                            BorderBrush="{ThemeResource TileStrokeBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource CardCornerRadius}"
                            Padding="12,10">
                        <Grid ColumnSpacing="10" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Mute Toggle Button -->
                            <Button Grid.Column="0"
                                    Command="{x:Bind ViewModel.ToggleMuteCommand, Mode=OneWay}"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    Padding="6"
                                    CornerRadius="6"
                                    VerticalAlignment="Center"
                                    ToolTipService.ToolTip="Toggle Mute">
                                <FontIcon Glyph="{x:Bind ViewModel.VolumeGlyph, Mode=OneWay}" FontSize="15"
                                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            </Button>

                            <!-- Volume Slider & Device Label -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{x:Bind ViewModel.AudioDeviceName, Mode=OneWay}"
                                           FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                                <Slider Value="{x:Bind ViewModel.VolumeLevel, Mode=TwoWay}"
                                        Minimum="0" Maximum="100" StepFrequency="1"
                                        Margin="0,-6,0,-6" />
                            </StackPanel>

                            <!-- Volume % Text -->
                            <TextBlock Grid.Column="2"
                                       Text="{x:Bind ViewModel.VolumeMetricText, Mode=OneWay}"
                                       FontWeight="SemiBold" FontSize="12"
                                       VerticalAlignment="Center" Width="40" TextAlignment="Right" />
                        </Grid>
                    </Border>

                    <!-- Media Controller Card -->
                    <Border Grid.Column="1"
                            Background="{ThemeResource CardBackgroundBrush}"
                            BorderBrush="{ThemeResource TileStrokeBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource CardCornerRadius}"
                            Padding="12,10">
                        <Grid ColumnSpacing="10" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Media Icon -->
                            <Border Grid.Column="0"
                                    Background="{ThemeResource PillBackgroundBrush}"
                                    BorderBrush="{ThemeResource TileStrokeBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Width="32" Height="32">
                                <FontIcon Glyph="&#xE8D6;" FontSize="14"
                                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <!-- Media Track & Artist -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.MediaTitle, Mode=OneWay}"
                                           FontWeight="SemiBold" FontSize="12"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind ViewModel.MediaArtist, Mode=OneWay}"
                                           FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <!-- Transport Controls -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                <Button Command="{x:Bind ViewModel.SkipPreviousCommand, Mode=OneWay}"
                                        Background="Transparent" BorderBrush="Transparent"
                                        Padding="6" CornerRadius="6"
                                        ToolTipService.ToolTip="Previous Track">
                                    <FontIcon Glyph="&#xE892;" FontSize="12" />
                                </Button>
                                <Button Command="{x:Bind ViewModel.TogglePlayPauseCommand, Mode=OneWay}"
                                        Background="{ThemeResource PillBackgroundBrush}"
                                        BorderBrush="{ThemeResource TileStrokeBrush}"
                                        Padding="8,6" CornerRadius="6"
                                        ToolTipService.ToolTip="Play / Pause">
                                    <FontIcon Glyph="{x:Bind ViewModel.PlayPauseGlyph, Mode=OneWay}" FontSize="12"
                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                </Button>
                                <Button Command="{x:Bind ViewModel.SkipNextCommand, Mode=OneWay}"
                                        Background="Transparent" BorderBrush="Transparent"
                                        Padding="6" CornerRadius="6"
                                        ToolTipService.ToolTip="Next Track">
                                    <FontIcon Glyph="&#xE893;" FontSize="12" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- System Controls -->
                <StackPanel Visibility="{x:Bind HasSystemModules(ViewModel), Mode=OneWay}">
                    <controls:QuickDockSection Title="System Controls" Badge="3" />
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.FilteredSystemModules, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout MinItemWidth="240" MinRowSpacing="8" MinColumnSpacing="8" Orientation="Horizontal" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:ModuleTileItem">
                                <controls:QuickDockModuleTile Glyph="{x:Bind Glyph}"
                                                              Title="{x:Bind Title}"
                                                              Subtitle="{x:Bind Subtitle}"
                                                              StatusText="{x:Bind StatusText}"
                                                              Tapped="OnTileTapped"
                                                              Tag="{x:Bind}" />
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>

                <!-- Productivity Section -->
                <StackPanel Visibility="{x:Bind HasProductivityModules(ViewModel), Mode=OneWay}">
                    <controls:QuickDockSection Title="Productivity" Badge="4" />
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.FilteredProductivityModules, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout MinItemWidth="240" MinRowSpacing="8" MinColumnSpacing="8" Orientation="Horizontal" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:ModuleTileItem">
                                <controls:QuickDockModuleTile Glyph="{x:Bind Glyph}"
                                                              Title="{x:Bind Title}"
                                                              Subtitle="{x:Bind Subtitle}"
                                                              StatusText="{x:Bind StatusText}"
                                                              Tapped="OnTileTapped"
                                                              Tag="{x:Bind}" />
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>

                <!-- Utilities Section -->
                <StackPanel Visibility="{x:Bind HasUtilityModules(ViewModel), Mode=OneWay}">
                    <controls:QuickDockSection Title="Utilities" Badge="3" />
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.FilteredUtilityModules, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout MinItemWidth="240" MinRowSpacing="8" MinColumnSpacing="8" Orientation="Horizontal" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:ModuleTileItem">
                                <controls:QuickDockModuleTile Glyph="{x:Bind Glyph}"
                                                              Title="{x:Bind Title}"
                                                              Subtitle="{x:Bind Subtitle}"
                                                              StatusText="{x:Bind StatusText}"
                                                              Tapped="OnTileTapped"
                                                              Tag="{x:Bind}" />
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>

                <!-- Developer & Advanced Section -->
                <StackPanel Visibility="{x:Bind HasDeveloperModules(ViewModel), Mode=OneWay}">
                    <controls:QuickDockSection Title="Developer &amp; AI" Badge="3" />
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.FilteredDeveloperModules, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout MinItemWidth="240" MinRowSpacing="8" MinColumnSpacing="8" Orientation="Horizontal" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:ModuleTileItem">
                                <controls:QuickDockModuleTile Glyph="{x:Bind Glyph}"
                                                              Title="{x:Bind Title}"
                                                              Subtitle="{x:Bind Subtitle}"
                                                              StatusText="{x:Bind StatusText}"
                                                              Tapped="OnTileTapped"
                                                              Tag="{x:Bind}" />
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
