<Window x:Class="QuickDock.Setup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QuickDock Setup"
        Width="680" Height="520"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <!-- Outer Rounded Shell -->
    <Border Background="#0D0D0D"
            BorderBrush="#242424"
            BorderThickness="1"
            CornerRadius="20"
            Padding="36,24,36,28">

        <Grid>
            <Grid.RowDefinitions>
                <!-- Top Header / Close Row -->
                <RowDefinition Height="36" />
                <!-- Dynamic Content Carousel Row -->
                <RowDefinition Height="*" />
                <!-- Bottom Action & Pagination Row -->
                <RowDefinition Height="50" />
            </Grid.RowDefinitions>

            <!-- Top Close Button -->
            <Button Grid.Row="0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Style="{StaticResource CloseButtonStyle}"
                    Click="CloseButton_Click">
                <TextBlock Text="✕" FontSize="11" FontWeight="Bold" Margin="0,-1,0,0" />
            </Button>

            <!-- ======================================================== -->
            <!-- STEP 1: WELCOME TO QUICKDOCK                             -->
            <!-- ======================================================== -->
            <Grid x:Name="Step1Grid" Grid.Row="1" Visibility="Visible">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- Squircle Logo Icon -->
                    <Border Width="64" Height="64" CornerRadius="18" Background="#FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,16">
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Width="30" Height="14" CornerRadius="7" Background="#0D0D0D" Margin="0,4,0,0" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                                <Ellipse Width="4" Height="4" Fill="#FFFFFF" Margin="0,0,6,0" />
                                <Ellipse Width="4" Height="4" Fill="#FFFFFF" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TextBlock Text="Welcome to QuickDock"
                               FontSize="25"
                               FontWeight="Bold"
                               Foreground="#FFFFFF"
                               HorizontalAlignment="Center" />

                    <TextBlock Text="The notch, reimagined for Windows."
                               FontSize="13"
                               Foreground="#8E8E93"
                               HorizontalAlignment="Center"
                               Margin="0,6,0,24" />

                    <!-- Notch Preview Card -->
                    <Border Width="460" Height="140"
                            CornerRadius="16"
                            Background="#18181A"
                            BorderBrush="#242428"
                            BorderThickness="1">
                        <Grid>
                            <!-- Top Centered Notch Island -->
                            <Border Width="240" Height="36"
                                    Background="#000000"
                                    CornerRadius="0,0,16,16"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Top"
                                    Padding="16,0">
                                <Grid VerticalAlignment="Center">
                                    <TextBlock Text="11:59 AM"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="#FFFFFF"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Border Width="16" Height="9" BorderBrush="#FFFFFF" BorderThickness="1" CornerRadius="2" Margin="0,0,4,0">
                                            <Border Width="11" Height="5" Background="#FFFFFF" HorizontalAlignment="Left" Margin="1" />
                                        </Border>
                                        <TextBlock Text="80" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- ======================================================== -->
            <!-- STEP 2: OPEN THE NOTCH                                   -->
            <!-- ======================================================== -->
            <Grid x:Name="Step2Grid" Grid.Row="1" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Open the notch"
                               FontSize="25"
                               FontWeight="Bold"
                               Foreground="#FFFFFF"
                               HorizontalAlignment="Center" />

                    <TextBlock Text="Move your pointer to the top of your screen"
                               FontSize="13"
                               Foreground="#8E8E93"
                               HorizontalAlignment="Center"
                               Margin="0,6,0,24" />

                    <!-- Gesture Preview Card -->
                    <Border Width="460" Height="170"
                            CornerRadius="16"
                            Background="#18181A"
                            BorderBrush="#242428"
                            BorderThickness="1">
                        <Grid>
                            <!-- Notch Outline at Top -->
                            <Border Width="200" Height="28"
                                    Background="#101012"
                                    BorderBrush="#2E2E32"
                                    BorderThickness="1,0,1,1"
                                    CornerRadius="0,0,14,14"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Top" />

                            <!-- Glowing Arrow Up Indicator -->
                            <TextBlock Text="↑"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       Foreground="#FFFFFF"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Top"
                                       Margin="0,38,0,0" />

                            <!-- Ghost Preview Cards of Expanded Dock -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,20">
                                <Border Width="130" Height="64" Background="#121214" CornerRadius="10" Margin="0,0,12,0" />
                                <Border Width="130" Height="64" Background="#121214" CornerRadius="10" Margin="0,0,12,0" />
                                <Border Width="130" Height="64" Background="#121214" CornerRadius="10" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- ======================================================== -->
            <!-- STEP 3: PICK A LOOK                                      -->
            <!-- ======================================================== -->
            <Grid x:Name="Step3Grid" Grid.Row="1" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="520">
                    <TextBlock Text="Pick a look"
                               FontSize="25"
                               FontWeight="Bold"
                               Foreground="#FFFFFF"
                               HorizontalAlignment="Center" />

                    <TextBlock Text="It applies everywhere, right away"
                               FontSize="13"
                               Foreground="#8E8E93"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,20" />

                    <!-- 4 Theme Option Cards -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Theme 1: Pure Black (Selected) -->
                        <Border Grid.Column="0" Margin="4" CornerRadius="12" Background="#141416" BorderBrush="#FFFFFF" BorderThickness="1.5" Padding="8" Cursor="Hand" MouseDown="Theme_PureBlack_Click">
                            <StackPanel>
                                <Border Height="44" Background="#000000" CornerRadius="6" Margin="0,0,0,8">
                                    <Border Width="20" Height="6" Background="#262626" CornerRadius="0,0,3,3" VerticalAlignment="Top" />
                                </Border>
                                <TextBlock Text="Pure Black" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- Theme 2: Vivid -->
                        <Border Grid.Column="1" Margin="4" CornerRadius="12" Background="#141416" BorderBrush="#2A2A2E" BorderThickness="1" Padding="8" Cursor="Hand" MouseDown="Theme_Vivid_Click">
                            <StackPanel>
                                <Border Height="44" Background="#0C1424" CornerRadius="6" Margin="0,0,0,8">
                                    <Border Width="20" Height="6" Background="#0078D4" CornerRadius="0,0,3,3" VerticalAlignment="Top" />
                                </Border>
                                <TextBlock Text="Vivid" FontSize="11" FontWeight="SemiBold" Foreground="#CCCCCC" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- Theme 3: Ember Dark -->
                        <Border Grid.Column="2" Margin="4" CornerRadius="12" Background="#141416" BorderBrush="#2A2A2E" BorderThickness="1" Padding="8" Cursor="Hand" MouseDown="Theme_Ember_Click">
                            <StackPanel>
                                <Border Height="44" Background="#1E120A" CornerRadius="6" Margin="0,0,0,8">
                                    <Border Width="20" Height="6" Background="#FF6B22" CornerRadius="0,0,3,3" VerticalAlignment="Top" />
                                </Border>
                                <TextBlock Text="Ember Dark" FontSize="11" FontWeight="SemiBold" Foreground="#CCCCCC" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- Theme 4: Silver -->
                        <Border Grid.Column="3" Margin="4" CornerRadius="12" Background="#141416" BorderBrush="#2A2A2E" BorderThickness="1" Padding="8" Cursor="Hand" MouseDown="Theme_Silver_Click">
                            <StackPanel>
                                <Border Height="44" Background="#ECECF0" CornerRadius="6" Margin="0,0,0,8">
                                    <Border Width="20" Height="6" Background="#404040" CornerRadius="0,0,3,3" VerticalAlignment="Top" />
                                </Border>
                                <TextBlock Text="Silver" FontSize="11" FontWeight="SemiBold" Foreground="#CCCCCC" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Edge Light Toggle Row -->
                    <Border Background="#161618" CornerRadius="10" Padding="14,10" Margin="0,0,0,10">
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Edge Light" FontSize="12.5" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                <TextBlock Text="A light that runs along the notch outline" FontSize="10.5" Foreground="#777777" />
                            </StackPanel>
                            <CheckBox x:Name="EdgeLightCheckBox" HorizontalAlignment="Right" Style="{StaticResource ModernToggleStyle}" IsChecked="True" />
                        </Grid>
                    </Border>

                    <!-- Style Pills Row -->
                    <Border Background="#161618" CornerRadius="10" Padding="14,10">
                        <Grid>
                            <TextBlock Text="Style" FontSize="12.5" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Border Background="#222226" CornerRadius="14" Padding="12,5" Margin="0,0,6,0" Cursor="Hand">
                                    <TextBlock Text="Comet" FontSize="11" Foreground="#999999" />
                                </Border>
                                <Border Background="#FFFFFF" CornerRadius="14" Padding="12,5" Margin="0,0,6,0" Cursor="Hand">
                                    <TextBlock Text="Twin comets" FontSize="11" FontWeight="SemiBold" Foreground="#000000" />
                                </Border>
                                <Border Background="#222226" CornerRadius="14" Padding="12,5" Cursor="Hand">
                                    <TextBlock Text="Breathe" FontSize="11" Foreground="#999999" />
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- ======================================================== -->
            <!-- STEP 4: YOU'RE ALL SET                                   -->
            <!-- ======================================================== -->
            <Grid x:Name="Step4Grid" Grid.Row="1" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="480">
                    <TextBlock Text="You're all set"
                               FontSize="25"
                               FontWeight="Bold"
                               Foreground="#FFFFFF"
                               HorizontalAlignment="Center" />

                    <TextBlock Text="Everything is ready on your PC"
                               FontSize="13"
                               Foreground="#8E8E93"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,20" />

                    <!-- Card 1: Launch at Login -->
                    <Border Background="#18181A" CornerRadius="12" Padding="16,12" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!-- Gear Icon -->
                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="10" Background="#26262B" Margin="0,0,14,0">
                                <TextBlock Text="⚙" FontSize="16" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Launch at login" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                <TextBlock Text="Start QuickDock when you sign in to Windows" FontSize="11" Foreground="#7E7E84" />
                            </StackPanel>
                            <CheckBox x:Name="LaunchAtLoginCheckBox" Grid.Column="2" Style="{StaticResource ModernToggleStyle}" IsChecked="True" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Card 2: Everything Stays on this PC -->
                    <Border Background="#18181A" CornerRadius="12" Padding="16,12" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!-- Shield Icon -->
                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="10" Background="#0A2540" Margin="0,0,14,0">
                                <TextBlock Text="🛡" FontSize="15" Foreground="#0078D4" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Everything stays on this PC" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                <TextBlock Text="Notes, clipboard and settings never leave it" FontSize="11" Foreground="#7E7E84" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Card 3: 100% Offline & Free -->
                    <Border Background="#18181A" CornerRadius="12" Padding="16,12" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!-- Key / Check Icon -->
                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="10" Background="#0D2E1A" Margin="0,0,14,0">
                                <TextBlock Text="🔑" FontSize="15" Foreground="#2EA44F" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="100% Local &amp; Lifetime Free" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                <TextBlock Text="Every tool is unlocked. No cloud, no card needed" FontSize="11" Foreground="#7E7E84" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Installation Progress Indicator -->
                    <ProgressBar x:Name="SetupProgressBar" Height="4" Background="#222226" Foreground="#FFFFFF" IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,0,8" />
                    <TextBlock x:Name="StatusMessageText" FontSize="11" Foreground="#888888" HorizontalAlignment="Center" Text="" />
                </StackPanel>
            </Grid>

            <!-- ======================================================== -->
            <!-- BOTTOM BAR: DOTS & ACTION BUTTONS                        -->
            <!-- ======================================================== -->
            <Grid Grid.Row="2" VerticalAlignment="Bottom">
                <!-- Pagination Dots (Left) -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <Ellipse x:Name="Dot1" Width="7" Height="7" Fill="#FFFFFF" Margin="0,0,6,0" />
                    <Ellipse x:Name="Dot2" Width="7" Height="7" Fill="#333333" Margin="0,0,6,0" />
                    <Ellipse x:Name="Dot3" Width="7" Height="7" Fill="#333333" Margin="0,0,6,0" />
                    <Ellipse x:Name="Dot4" Width="7" Height="7" Fill="#333333" />
                </StackPanel>

                <!-- Navigation Buttons (Right) -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <!-- Back Button -->
                    <Button x:Name="BackButton"
                            Content="Back"
                            Style="{StaticResource TextButtonStyle}"
                            Visibility="Collapsed"
                            Margin="0,0,8,0"
                            Click="BackButton_Click" />

                    <!-- Skip Button -->
                    <Button x:Name="SkipButton"
                            Content="Skip"
                            Style="{StaticResource TextButtonStyle}"
                            Visibility="Visible"
                            Margin="0,0,8,0"
                            Click="SkipButton_Click" />

                    <!-- Primary Capsule Action Button -->
                    <Button x:Name="PrimaryActionButton"
                            Content="Get started"
                            Style="{StaticResource PillButtonStyle}"
                            Click="PrimaryActionButton_Click" />
                </StackPanel>
            </Grid>

        </Grid>
    </Border>
</Window>
