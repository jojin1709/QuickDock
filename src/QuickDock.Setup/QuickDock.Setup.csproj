<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets/AppIcon.ico</ApplicationIcon>
    <RootNamespace>QuickDock.Setup</RootNamespace>
    <AssemblyName>QuickDock-Setup</AssemblyName>
    
    <!-- Single-file release packaging -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    
    <!-- Versioning and Attribution -->
    <Version>1.0.1</Version>
    <AssemblyVersion>1.0.1.0</AssemblyVersion>
    <FileVersion>1.0.1.0</FileVersion>
    <Product>QuickDock Setup</Product>
    <Company>JOJIN JOHN</Company>
    <Authors>JOJIN JOHN</Authors>
    <Copyright>Copyright © 2026 JOJIN JOHN. All rights reserved.</Copyright>
    <Description>Modern Setup Experience for QuickDock Windows 11 Utility Dock</Description>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets/AppIcon.ico" />
    <Resource Include="Assets/icon-64x64.png" />
    <Resource Include="Assets/icon-256x256.png" />
    <Resource Include="Assets/QuickDock-Logo.png" />
    <!-- Embedded installation payload archive with fixed logical name -->
    <EmbeddedResource Include="payload.zip" LogicalName="payload.zip" />
  </ItemGroup>

  <Target Name="EnsurePayloadZipBeforeBuild" BeforeTargets="BeforeBuild">
    <Exec Command="powershell -Command &quot;if (-not (Test-Path 'payload.zip')) { New-Item -ItemType File -Path 'payload.dummy' -Force; Compress-Archive -Path 'payload.dummy' -DestinationPath 'payload.zip' -Force; Remove-Item 'payload.dummy' -Force }&quot;" Condition="!Exists('payload.zip')" />
  </Target>
</Project>
